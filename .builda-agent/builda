        if coi_enabled:
            raise SystemExit("Godot Web export requests cross-origin isolation headers. For WebView compatibility mode, set progressive_web_app/ensure_cross_origin_isolation_headers=false and re-export.")

    checks = [
        (r"\bINITIAL_MEMORY\b\s*[:=]\s*(\d+)", "INITIAL_MEMORY", "bytes"),
        (r"\binitialMemory\b\s*[:=]\s*(\d+)", "initialMemory", "bytes"),
        (r"\bwasmMemory\b\s*[:=]\s*(\d+)", "wasmMemory", "bytes"),
        (r"WebAssembly\.Memory\s*\(\s*\{[^}]*\binitial\b\s*:\s*(\d+)", "WebAssembly.Memory.initial", "pages"),
    ]
    detected = []
    for pattern, label, unit in checks:
        for raw in re.findall(pattern, index_js):
            value = int(raw)
            bytes_value = value * 65536 if unit == "pages" else value
            detected.append((label, bytes_value))
