inject_sdk_version() {
  # sdkVersion follows the project's SDK install receipt (written by sdk install); after draft reporting it goes into the release manifest's
  # sdk contract, and the host downloads the runtime SDK by it; do not maintain this field by hand.
  local file="$1" v tmp
  [ -f "$SDK_VERSION_FILE" ] || return 0
  v="$(head -n 1 "$SDK_VERSION_FILE" | tr -d '\r')"
  [ -n "$v" ] || return 0
  tmp="$(mktemp)"
  if command -v jq >/dev/null 2>&1; then
    if jq --arg v "$v" '.sdkVersion=$v' "$file" > "$tmp" 2>/dev/null; then mv "$tmp" "$file"; else rm -f "$tmp"; fi
  elif command -v python3 >/dev/null 2>&1; then
    if python3 - "$file" "$v" > "$tmp" 2>/dev/null <<'PYSDK'
import json, os, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
data["sdkVersion"] = sys.argv[2]
json.dump(data, sys.stdout, ensure_ascii=False, separators=(",", ":"))
PYSDK
    then mv "$tmp" "$file"; else rm -f "$tmp"; fi
  else
    rm -f "$tmp"
  fi
}

preflight_manifest_for_draft() {
