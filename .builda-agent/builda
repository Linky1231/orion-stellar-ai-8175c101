# version_newer A B: returns 0 when semver A is strictly greater than B. Auto-update only upgrades: a stale version briefly cached by the CDN after release,
# or a production rollback, never auto-downgrades the local toolchain (use builda update to sync explicitly if needed). Unparseable => treat as "no update".
version_newer() {
  local a="$1" b="$2" i
  local -a x y
  [[ "$a" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$b" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  IFS=. read -r -a x <<<"$a"
  IFS=. read -r -a y <<<"$b"
  for i in 0 1 2; do
    ((10#${x[i]} > 10#${y[i]})) && return 0
    ((10#${x[i]} < 10#${y[i]})) && return 1
  done
  return 1
}

