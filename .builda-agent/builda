validate_manifest_pay_points() {
  local file="$1"
  [ -f "$file" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$file" <<'PY'
import json
import re
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
if "payPoints" not in data:
    raise SystemExit(0)
points = data.get("payPoints")
if not isinstance(points, list) or len(points) == 0:
    print("payPoints must be omitted for games without in-app purchases; do not send an empty array.", file=sys.stderr)
    raise SystemExit(1)
seen = set()
pay_id_re = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
for i, point in enumerate(points):
    if not isinstance(point, dict):
        print(f"payPoints[{i}] must be an object with payId/payName/price.", file=sys.stderr)
        raise SystemExit(1)
    pay_id = point.get("payId")
    pay_name = str(point.get("payName") or "").strip()
    price = point.get("price")
    if "grantBy" in point and (not isinstance(point["grantBy"], str) or point["grantBy"] not in ("", "client", "room")):
        print(f"payPoints[{i}].grantBy must be a string: client or room; omission or empty string means client.", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(pay_id, str) or not pay_id_re.fullmatch(pay_id):
        print(f"payPoints[{i}].payId must be a string matching [A-Za-z0-9_-] with 1-64 bytes.", file=sys.stderr)
        raise SystemExit(1)
    if pay_id in seen:
        print(f"payPoints payId duplicated: {pay_id}", file=sys.stderr)
        raise SystemExit(1)
    seen.add(pay_id)
    if not pay_name:
        print(f"payPoints[{i}].payName is required.", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(price, int) or isinstance(price, bool):
        print(f"payPoints[{i}].price must be an integer G-coin amount.", file=sys.stderr)
        raise SystemExit(1)
    if price < 100:
        print(f"payPoints[{i}].price must be at least 100 G-coins.", file=sys.stderr)
        raise SystemExit(1)
PY
}

