builda_dev_parse() {
  local web="" port="18088" game_id="local-game" safearea="" assets=""
  local mode="${1:-serve}"
  if [ "$mode" = "e2e" ]; then
    echo "dev-e2e=removed" >&2
    echo "builda dev e2e has been removed: it only re-asserted the built-in SDK mock behavior. Use builda dev to start the local runner and verify the real game in a browser instead." >&2
    exit 1
  fi
  if [ "$mode" = "serve" ]; then
    shift || true
  else
    mode="serve"
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --web)
        web="${2:-}"
        shift 2
        ;;
      --web=*)
        web="${1#--web=}"
        shift
        ;;
      --port)
        port="${2:-}"
        shift 2
        ;;
      --port=*)
        port="${1#--port=}"
        shift
        ;;
      --game-id)
        game_id="${2:-}"
        shift 2
        ;;
      --game-id=*)
        game_id="${1#--game-id=}"
        shift
        ;;
      --safearea)
        safearea="${2:-}"
        shift 2
        ;;
      --safearea=*)
        safearea="${1#--safearea=}"
        shift
        ;;
      --assets)
        assets="${2:-}"
        shift 2
        ;;
      --assets=*)
        assets="${1#--assets=}"
        shift
        ;;
      ""|-h|--help|help)
        echo "Usage: builda dev --web <dir|zip> [--assets <dir|zip>] [--port 18088] [--game-id local-game] [--safearea 44,0,34,0]"
        return 0
        ;;
      *)
        echo "Unknown dev arg: $1" >&2
        echo "Usage: builda dev --web <dir|zip> [--assets <dir|zip>] [--port 18088] [--game-id local-game] [--safearea 44,0,34,0]" >&2
        exit 1
        ;;
    esac
  done
  [ -n "$web" ] || { echo "Usage: builda dev --web <dir|zip> [--port 18088]" >&2; exit 1; }
  [ -e "$web" ] || { echo "dev web path not found: $web" >&2; exit 1; }
  # assets fallback source: if not specified explicitly, probe the project root ./assets (audio|res top-level subtrees, same layout as assets.zip)
  if [ -z "$assets" ] && { [ -d "assets/audio" ] || [ -d "assets/res" ]; }; then
    assets="assets"
  fi
  if [ -n "$assets" ] && [ ! -e "$assets" ]; then
    echo "dev assets path not found: $assets" >&2
    exit 1
  fi
  builda_dev_serve "$web" "$port" "$game_id" "$safearea" "$assets"
}

