legacy_home_migrate() {
  # The CLI body still sits in the old user-level directory (where an old self-update dropped the new CLI):
  # move the toolchain into the current project, keep credentials in place, then rerun the original command with the project's new body.
  local target_root="$PWD/$PROJECT_STATE_DIR"
  echo "layout-migration=required (toolchain moved from \$HOME to per-project)" >&2
  if [ "$PWD" = "$HOME" ] || [ "$target_root" = "$SELF_DIR" ]; then
    echo "The BuildaGame toolchain is now project-level: cd to the game project root and rerun the command;" >&2
    echo "the migration then happens automatically (credentials stay in the credentials directory under \$HOME)." >&2
    exit 1
  fi
  mkdir -p "$target_root"
  cp "$SELF_DIR/builda" "$target_root/builda"
  chmod +x "$target_root/builda"
  [ -f "$SELF_DIR/SKILL.md" ] && cp "$SELF_DIR/SKILL.md" "$target_root/SKILL.md"
  [ -f "$SELF_DIR/VERSION" ] && cp "$SELF_DIR/VERSION" "$target_root/VERSION"
  [ -f "$SELF_DIR/publish.env" ] && cp "$SELF_DIR/publish.env" "$target_root/publish.env"
  sync_project_registrations >/dev/null
  # Leave only credentials in the old user-level directory; also remove global skill registrations (global context cleanup)
  local f
  for f in builda builda.ps1 builda.cmd SKILL.md VERSION AGENT_INSTALL.md publish.env \
           md_cysj_app.md md_cjk_font.md md_mobile_perf.md \
           last-build.json last-assets.json last-draft.json last-game-id last-draft-id last-version-id; do
    rm -f "$SELF_DIR/$f"
  done
  rm -rf "${CODEX_HOME:-$HOME/.codex}/skills/builda-godot" "$HOME/.claude/skills/builda-godot" \
         "${CODEX_HOME:-$HOME/.codex}/skills/builda" "$HOME/.claude/skills/builda"
  rm -f "$HOME/.cursor/rules/builda-godot.mdc" "$HOME/Documents/Cline/Rules/builda-godot.md" \
        "$HOME/.cursor/rules/builda.mdc" "$HOME/Documents/Cline/Rules/builda.md"
  echo "layout-migration=done target=$target_root (credentials kept in $AUTH_DIR)" >&2
  exec "$target_root/builda" "$@"
}

legacy_project_dir_migrate() {
  # The CLI body sits in the old-named project directory .builda-godot-agent/ (pre multi-engine install):
  # move the content into .builda-agent/, rewrite the registration stub, delete the old directory, then hand the original command to the CLI at the new path.
  local target_root="$PWD/$PROJECT_STATE_DIR"
  echo "layout-migration=required (toolchain dir renamed $LEGACY_PROJECT_STATE_DIR -> $PROJECT_STATE_DIR)" >&2
  if [ "$(cd "$LEGACY_PROJECT_STATE_DIR" 2>/dev/null && pwd -P || true)" != "$SELF_DIR" ]; then
    echo "run-from=project-root-required" >&2
    echo "This CLI is a project-level tool; run the migration from the root of the project it belongs to:" >&2
    echo "  cd $(dirname "$SELF_DIR") && ./$LEGACY_PROJECT_STATE_DIR/builda <command>" >&2
    exit 1
  fi
  mkdir -p "$target_root"
  local f
  for f in builda builda.ps1 builda.cmd SKILL.md VERSION publish.env game.json sdk-version \
           last-build.json last-assets.json last-draft.json last-game-id last-draft-id last-version-id \
           md_cysj_app.md md_cjk_font.md md_mobile_perf.md md_rankboards.md; do
    [ -f "$SELF_DIR/$f" ] && cp "$SELF_DIR/$f" "$target_root/$f"
  done
  [ -d "$SELF_DIR/sdk" ] && cp -R "$SELF_DIR/sdk" "$target_root/sdk"
  chmod +x "$target_root/builda" 2>/dev/null || true
  sync_project_registrations >/dev/null
  rm -rf "$SELF_DIR"
  echo "layout-migration=done target=$target_root" >&2
  exec "$target_root/builda" "$@"
}

legacy_auth_migrate() {
  # Credential directory rename migration: copy, do not delete -- old CLIs (in other projects not yet self-updated) still read the old directory.
  # uninstall --purge removes both generations; no migration when BUILDA_AUTH_DIR is explicitly overridden.
  [ -n "${BUILDA_AUTH_DIR:-}" ] && return 0
  [ -f "$TOKEN_FILE" ] && return 0
  [ -f "$LEGACY_AUTH_DIR/token" ] || return 0
  mkdir -p "$AUTH_DIR"
  cp "$LEGACY_AUTH_DIR/token" "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  if [ -f "$LEGACY_AUTH_DIR/refresh-token" ] && [ ! -f "$REFRESH_FILE" ]; then
    cp "$LEGACY_AUTH_DIR/refresh-token" "$REFRESH_FILE"
    chmod 600 "$REFRESH_FILE"
  fi
  echo "auth-migration=copied credentials $LEGACY_AUTH_DIR -> $AUTH_DIR (legacy kept for old CLIs)" >&2
}

require_project_context() {
  if [ "$SELF_DIR" = "$AUTH_DIR" ] || [ "$SELF_DIR" = "$LEGACY_AUTH_DIR" ]; then
    legacy_home_migrate "$@"
  fi
  if [ "$(basename "$SELF_DIR")" = "$LEGACY_PROJECT_STATE_DIR" ] && [ "$PROJECT_STATE_DIR" != "$LEGACY_PROJECT_STATE_DIR" ]; then
    legacy_project_dir_migrate "$@"
  fi
  if [ "$(cd "$PROJECT_STATE_DIR" 2>/dev/null && pwd -P || true)" != "$SELF_DIR" ]; then
    echo "run-from=project-root-required" >&2
    echo "This CLI is a project-level tool; run it from the root of the project it belongs to:" >&2
    echo "  cd $(dirname "$SELF_DIR") && ./$PROJECT_STATE_DIR/builda <command>" >&2
    exit 1
  fi
}

remove_if_exists() {
  local path="$1"
  if [ -e "$path" ] || [ -L "$path" ]; then
    rm -rf "$path"
    echo "removed=$path"
  fi
}

uninstall_builda() {
  local purge=0
  case "${1:-}" in
    --purge) purge=1 ;;
    "" ) ;;
    -h|--help|help)
      echo "Usage: builda uninstall [--purge]"
      echo "Default removes the project toolchain and agent registrations, keeps game.json/sdk-version"
      echo "and the per-user credentials in \$HOME/.builda-agent/."
      echo "--purge also removes the whole $ROOT directory AND per-user credentials"
      echo "(credentials are shared by every project on this machine)."
      return 0
      ;;
    *) echo "unknown uninstall option: $1" >&2; exit 1 ;;
  esac

  # Project-level registration (clear both old and new stub names)
  remove_if_exists ".claude/skills/builda"
  remove_if_exists ".cursor/rules/builda.mdc"
  remove_if_exists ".clinerules/builda.md"
  remove_if_exists ".roo/rules/builda.md"
  remove_if_exists ".windsurf/rules/builda.md"
  remove_if_exists ".claude/skills/builda-godot"
  remove_if_exists ".cursor/rules/builda-godot.mdc"
  remove_if_exists ".clinerules/builda-godot.md"
  remove_if_exists ".roo/rules/builda-godot.md"
  remove_if_exists ".windsurf/rules/builda-godot.md"
  remove_agents_md_block
  # Also clean up legacy global registrations (written to $HOME by old versions)
  remove_if_exists "${CODEX_HOME:-$HOME/.codex}/skills/builda-godot"
  remove_if_exists "$HOME/.claude/skills/builda-godot"
  remove_if_exists "$HOME/.cursor/rules/builda-godot.mdc"
  remove_if_exists "$HOME/Documents/Cline/Rules/builda-godot.md"

  if [ "$purge" = "1" ]; then
    remove_if_exists "$ROOT"
    remove_if_exists "$LEGACY_PROJECT_STATE_DIR"
    remove_if_exists "$TOKEN_FILE"
    remove_if_exists "$REFRESH_FILE"
    remove_if_exists "$LEGACY_AUTH_DIR/token"
    remove_if_exists "$LEGACY_AUTH_DIR/refresh-token"
    echo "uninstall=ok"
    echo "uninstall-mode=purge (credentials removed for ALL projects on this machine)"
    return 0
  fi

  local f
  for f in SKILL.md md_cysj_app.md md_cjk_font.md md_mobile_perf.md builda builda.ps1 builda.cmd \
           VERSION AGENT_INSTALL.md publish.env last-build.json last-assets.json last-draft.json \
           last-game-id last-draft-id last-version-id; do
    remove_if_exists "$ROOT/$f"
  done
  echo "uninstall=ok"
  echo "uninstall-mode=keep-project-data (game.json/sdk-version kept; credentials kept in $AUTH_DIR)"
  [ -f "$TOKEN_FILE" ] && echo "grant=kept"
  [ -f "$REFRESH_FILE" ] && echo "agent-authorization=kept"
  true
}

self_update() {
  local new_version="${1:-$VERSION}"
  mkdir -p "$ROOT"
  local cli_tmp windows_cli_tmp windows_cmd_tmp skill_tmp
  cli_tmp="$(mktemp)"
  windows_cli_tmp="$(mktemp)"
  windows_cmd_tmp="$(mktemp)"
  skill_tmp="$(mktemp)"
  curl -fsSL "$BUILDA_AGENT_BASE/agent/builda" -o "$cli_tmp"
  curl -fsSL "$BUILDA_AGENT_BASE/agent/builda.ps1" -o "$windows_cli_tmp"
  curl -fsSL "$BUILDA_AGENT_BASE/agent/builda.cmd" -o "$windows_cmd_tmp"
  curl -fsSL "$BUILDA_AGENT_BASE/agent/builda-skill.md" -o "$skill_tmp"
  mv "$skill_tmp" "$ROOT/SKILL.md"
  mv "$cli_tmp" "$ROOT/builda"
  mv "$windows_cli_tmp" "$ROOT/builda.ps1"
  mv "$windows_cmd_tmp" "$ROOT/builda.cmd"
  chmod +x "$ROOT/builda"
  printf '%s\n' "$new_version" > "$RUNTIME_VERSION_FILE"
  echo "self-update=updated"
  echo "Agent registrations:"
  sync_project_registrations
}

check_update() {
  local remote sdkv
  remote="$(remote_version)"
  # CLI / base Skill share one version; the game SDK is pinned separately.
  echo "builda-version=$VERSION"
  echo "toolchain-version=$VERSION"
  if [ -n "$remote" ]; then
    echo "remote-version=$remote"
    if version_newer "$remote" "$VERSION"; then
      self_update "$remote"
      echo "builda-agent-skill-updated=1"
      echo "action=rerun-current-command-with-updated-cli-and-reread-skill"
      exec "$ROOT/builda" check
    elif [ "$remote" = "$VERSION" ]; then
      echo "self-update=current"
    else
      echo "self-update=skipped (remote $remote is not newer than local $VERSION; run builda update to sync explicitly)"
    fi
  else
    echo "remote-version=unknown"
    echo "self-update=skipped"
  fi
  [ -f "$ROOT/SKILL.md" ] && echo "skill=installed" || echo "skill=missing (run: builda update)"
  if [ -f "$SDK_VERSION_FILE" ]; then
    sdkv="$(head -n 1 "$SDK_VERSION_FILE" | tr -d '\r')"
    echo "sdk-version=$sdkv"
    sdk_guidance || true
    echo "sdk-sync=independent (SDK version pinned per project; upgrade explicitly: builda sdk upgrade)"
    sdk_online_status
  elif [ -d addons/builda ] || [ -d "$PROJECT_STATE_DIR/sdk/web" ]; then
    echo "sdk-version=unknown (missing $SDK_VERSION_FILE; run: builda sdk install)"
  else
    echo "sdk=not-installed"
    sdk_discover
  fi
}

maybe_self_update() {
  local first="${1:-}" remote
  case "$first" in
    ""|-h|--help|help|check|update|uninstall|version|--version|-v)
      return 0
      ;;
  esac
  [ "${BUILDA_DISABLE_AUTO_UPDATE:-}" = "1" ] && return 0
  remote="$(remote_version)"
  if [ -n "$remote" ] && version_newer "$remote" "$VERSION"; then
    echo "self-update-required=1" >&2
    self_update "$remote" >&2
    echo "builda-agent-skill-updated=1" >&2
    echo "action=rerun-current-command-with-updated-cli-and-reread-skill" >&2
    exec "$ROOT/builda" "$@"
  fi
}

project_game_id() {
  migrate_legacy_project_file
  [ -f "$PROJECT_FILE" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r '.gameId // empty' "$PROJECT_FILE"
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$PROJECT_FILE" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as f:
    print(json.load(f).get("gameId", ""))
PY
  else
    sed -n 's/.*"gameId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PROJECT_FILE" | head -1
  fi
}

cloud_advisory_cache_file() {
  printf '%s/cache/cloud-state-advisories.v1.json' "$ROOT"
}

cloud_advisory_client_action_id() {
  need_python3
  python3 - "$@" <<'PY'
import hashlib
import os
import sys
import time

digest = hashlib.sha256()
digest.update(b"builda-cloud-advisory-action-v1\0")
for value in sys.argv[1:]:
    digest.update(value.encode("utf-8") + b"\0")
digest.update(str(time.time_ns()).encode("ascii") + b"\0" + os.urandom(16))
print(digest.hexdigest())
PY
}

cloud_advisory_store_page() {
  local page="$1" source cache tmp_source tmp_cache
  need_python3
  source="$(mktemp)"
  cache="$(cloud_advisory_cache_file)"
  mkdir -p "$(dirname "$cache")"
  chmod 700 "$(dirname "$cache")"
  tmp_cache="$(mktemp "$(dirname "$cache")/.cloud-state-advisories.XXXXXX")"
  printf '%s' "$page" > "$source"
  python3 - "$source" > "$tmp_cache" <<'PY'
import datetime
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as handle:
    page = json.load(handle)
if not isinstance(page, dict) or not isinstance(page.get("gameId"), str) or not isinstance(page.get("items"), list):
    raise SystemExit("invalid Cloud State advisory response")
page["stale"] = False
page["fetchedAt"] = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
json.dump(page, sys.stdout, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
sys.stdout.write("\n")
PY
  rm -f "$source"
  chmod 600 "$tmp_cache"
  mv "$tmp_cache" "$cache"
  cat "$cache"
}

cloud_advisory_stale_page() {
  local cache
  need_python3
  cache="$(cloud_advisory_cache_file)"
  [ -f "$cache" ] || return 1
  python3 - "$cache" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as handle:
    page = json.load(handle)
page["stale"] = True
json.dump(page, sys.stdout, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
sys.stdout.write("\n")
PY
}

cloud_advisory_print_page() {
  need_python3
  python3 -c '
import json, sys
page = json.load(sys.stdin)
items = page.get("items", [])
stale = bool(page.get("stale", False))
if not items:
    print("cloud-state=pass advisories=0 stale=" + str(stale).lower())
else:
    print(f"cloud-state=attention advisories={len(items)} stale={str(stale).lower()}")
    for item in items[:5]:
        reasons = ",".join(item.get("reasonCodes", [])) or "UNKNOWN"
        print("advisory={} severity={} reason={} inspect={}".format(
            item.get("advisoryId", ""), item.get("severity", ""), reasons,
            item.get("inspectCommand", "")))
'
}

cloud_advisory_list() {
  local json=0 no_auth=0 cursor="" limit="" game_id url response decorated
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --no-auth-prompt) no_auth=1 ;;
      --cursor) shift; cursor="${1:-}" ;;
      --limit) shift; limit="${1:-}" ;;
      -h|--help|help)
        echo "Usage: builda cloud-advisories list [--json] [--no-auth-prompt] [--cursor <cursor>] [--limit <1..50>]"
        return 0
        ;;
      *) echo "Unknown cloud-advisories list option: $1" >&2; return 1 ;;
    esac
    shift
  done
  game_id="$(project_game_id)"
  [ -n "$game_id" ] || { echo "cloud-advisories=project-game-id-missing"; return 1; }
  if [ ! -f "$TOKEN_FILE" ]; then
    if [ "$no_auth" = "1" ]; then
      echo "cloud-advisories=auth-required"
      return 0
    fi
    need_token
  fi
  url="$BUILDA_BASE/api/v1/agent/cloud-advisories?gameId=$game_id"
  [ -z "$cursor" ] || url="$url&cursor=$cursor"
  [ -z "$limit" ] || url="$url&limit=$limit"
  if [ "$no_auth" = "1" ]; then
    if authenticated_http_response "list Cloud State advisories" "$url" 2>/dev/null && [[ "$AUTH_HTTP_STATUS" == 2* ]]; then
      decorated="$(cloud_advisory_store_page "$AUTH_HTTP_BODY")"
    else
      decorated="$(cloud_advisory_stale_page)" || { echo "cloud-advisories=unavailable"; return 0; }
    fi
  elif response="$(authenticated_http_request "list Cloud State advisories" "$url")"; then
    decorated="$(cloud_advisory_store_page "$response")"
  else
    decorated="$(cloud_advisory_stale_page)" || return 1
  fi
  if [ "$json" = "1" ]; then
    printf '%s\n' "$decorated"
  else
    printf '%s' "$decorated" | cloud_advisory_print_page
  fi
}

cloud_advisory_inspect() {
  local id="" json=0 game_id response
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --id) shift; id="${1:-}" ;;
      --json) json=1 ;;
      -h|--help|help) echo "Usage: builda cloud-advisories inspect --id <id> [--json]"; return 0 ;;
      *) echo "Unknown cloud-advisories inspect option: $1" >&2; return 1 ;;
    esac
    shift
  done
  game_id="$(project_game_id)"
  [ -n "$game_id" ] && [ -n "$id" ] || { echo "game id and advisory id are required" >&2; return 1; }
  need_token
  response="$(authenticated_http_request "inspect Cloud State advisory" "$BUILDA_BASE/api/v1/agent/cloud-advisories/$id?gameId=$game_id")"
  if [ "$json" = "1" ]; then
    printf '%s\n' "$response"
    return
  fi
  printf '%s' "$response" | python3 -m json.tool
}

cloud_advisory_match() {
  local id="" candidates="" game_id source body response
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --id) shift; id="${1:-}" ;;
      --candidates) shift; candidates="${1:-}" ;;
      -h|--help|help) echo "Usage: builda cloud-advisories match --id <id> --candidates <local-json>"; return 0 ;;
      *) echo "Unknown cloud-advisories match option: $1" >&2; return 1 ;;
    esac
    shift
  done
  game_id="$(project_game_id)"
  [ -n "$game_id" ] && [ -n "$id" ] && [ -f "$candidates" ] || { echo "game id, advisory id and candidates file are required" >&2; return 1; }
  need_token
  source="$(mktemp)"
  body="$(mktemp)"
  printf '%s' "$game_id" > "$source"
  python3 - "$source" "$candidates" > "$body" <<'PY'
import json
import sys
with open(sys.argv[1], "r", encoding="utf-8") as handle:
    game_id = handle.read()
with open(sys.argv[2], "r", encoding="utf-8") as handle:
    candidates = json.load(handle)
if not isinstance(candidates, list):
    raise SystemExit("candidates must be a JSON array")
json.dump({"gameId": game_id, "candidates": candidates}, sys.stdout, separators=(",", ":"))
PY
  rm -f "$source"
  response="$(authenticated_http_request "match Cloud State advisory" -X POST "$BUILDA_BASE/api/v1/agent/cloud-advisories/$id/match" -H 'Content-Type: application/json' --data-binary "@$body")"
  rm -f "$body"
  printf '%s\n' "$response"
}

cloud_advisory_action() {
  local action="$1"; shift
  local id="" generation="" revision="" release="" game_id client_id body response
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --id) shift; id="${1:-}" ;;
      --generation) shift; generation="${1:-}" ;;
      --revision) shift; revision="${1:-}" ;;
      --online-release) shift; release="${1:-}" ;;
      -h|--help|help)
        echo "Usage: builda cloud-advisories $action --id <id> --generation <n> [--revision <n>] [--online-release <ref>]"
        return 0
        ;;
      *) echo "Unknown cloud-advisories $action option: $1" >&2; return 1 ;;
    esac
    shift
  done
  game_id="$(project_game_id)"
  [ -n "$game_id" ] && [ -n "$id" ] && [ -n "$generation" ] || { echo "game id, advisory id and generation are required" >&2; return 1; }
  if [ "$action" = "ack" ]; then
    [ -n "$revision" ] || { echo "notification revision is required for ack" >&2; return 1; }
  else
    [ -n "$release" ] || { echo "online release is required for resolve" >&2; return 1; }
  fi
  need_token
  client_id="$(cloud_advisory_client_action_id "$action" "$id" "$generation" "$revision" "$release")"
  body="$(python3 - "$game_id" "$generation" "$revision" "$client_id" "$release" <<'PY'
import json
import sys
value = {"gameId": sys.argv[1], "generation": int(sys.argv[2]), "clientActionId": sys.argv[4]}
if sys.argv[3]:
    value["notificationRevision"] = int(sys.argv[3])
if sys.argv[5]:
    value["onlineRelease"] = sys.argv[5]
print(json.dumps(value, separators=(",", ":")))
PY
)"
  response="$(printf '%s' "$body" | authenticated_http_request "$action Cloud State advisory" -X POST "$BUILDA_BASE/api/v1/agent/cloud-advisories/$id/$action" -H 'Content-Type: application/json' --data-binary @-)"
  printf '%s\n' "$response"
}

cloud_advisories() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list) cloud_advisory_list "$@" ;;
    inspect) cloud_advisory_inspect "$@" ;;
    match) cloud_advisory_match "$@" ;;
    ack|resolve) cloud_advisory_action "$sub" "$@" ;;
    ""|-h|--help|help)
      echo "Usage: builda cloud-advisories list|inspect|match|ack|resolve"
      ;;
    *) echo "Unknown cloud-advisories command: $sub" >&2; return 1 ;;
  esac
}

bundle_identity() {
  local zip="$1" engine="$2"
  need_python3
  python3 - "$zip" "$engine" <<'PY'
import hashlib
import os
import sys

path = sys.argv[1]
engine = sys.argv[2].strip().lower() or "godot"
digest = hashlib.sha256()
studio_digest = hashlib.sha256()
