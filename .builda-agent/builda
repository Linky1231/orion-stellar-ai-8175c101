draft_idempotency_key() {
  local action="$1" game_id="$2" manifest_file="$3" existing_only="${4:-0}"
  mkdir -p "$ROOT"
  python3 - "$action" "$game_id" "$manifest_file" "$ROOT" "$existing_only" <<'PY'
import hashlib
import os
import re
import secrets
import sys
import time

action, game_id, path, root, existing_only = sys.argv[1:]
payload = hashlib.sha256()
with open(path, "rb") as manifest:
    for block in iter(lambda: manifest.read(1024 * 1024), b""):
        payload.update(block)
scope = "new" if not game_id else hashlib.sha256(game_id.encode("utf-8")).hexdigest()[:16]
payload_hex = payload.hexdigest()
fingerprint = hashlib.sha256(f"{action}\0{game_id}\0{payload_hex}".encode("utf-8")).hexdigest()
receipt = os.path.join(root, f"last-draft-operation-{fingerprint}")
prefix = f"draft-{action}-{scope}-{payload_hex}-"

if existing_only == "1":
    for _ in range(50):
        try:
            with open(receipt, "r", encoding="ascii") as saved:
                operation = saved.read().strip()
        except FileNotFoundError:
            raise SystemExit(0)
        except PermissionError:
            operation = ""
        if re.fullmatch(re.escape(prefix) + r"[0-9a-f]{32}", operation):
            print(operation)
            raise SystemExit(0)
        time.sleep(0.02)
    raise SystemExit(f"invalid or incomplete draft operation receipt: {receipt}; retry, or remove it if no publish is running")
try:
    fd = os.open(receipt, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    operation = ""
    for _ in range(50):
        try:
            with open(receipt, "r", encoding="ascii") as saved:
                operation = saved.read().strip()
        except (FileNotFoundError, PermissionError):
            operation = ""
        if re.fullmatch(re.escape(prefix) + r"[0-9a-f]{32}", operation):
            break
        time.sleep(0.02)
    else:
        raise SystemExit(f"invalid or incomplete draft operation receipt: {receipt}; retry, or remove it if no publish is running")
else:
    operation = prefix + secrets.token_hex(16)
    with os.fdopen(fd, "w", encoding="ascii") as saved:
        saved.write(operation + "\n")
        saved.flush()
        os.fsync(saved.fileno())
print(operation)
PY
}

complete_draft_operation() {
  local operation_id="$1"
  python3 - "$operation_id" "$ROOT" <<'PY'
import glob
import os
import sys

operation, root = sys.argv[1:]
for receipt in glob.glob(os.path.join(root, "last-draft-operation-*")):
    try:
        with open(receipt, "r", encoding="ascii") as saved:
            matches = saved.read().strip() == operation
        if matches:
