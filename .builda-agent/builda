render_upload_recovery() {
  need_python3
  local mode="$1"
  python3 -c '
import datetime, json, re, sys
mode = sys.argv[1]
try:
    data = json.load(sys.stdin)
except (ValueError, TypeError):
    sys.exit(0)
quota = data.get("quota") or {}
if mode == "blocked" and data.get("errorCode") != "upload_session_quota_exceeded" and data.get("msg") != "upload session quota exceeded":
    sys.exit(0)
if mode == "blocked":
    reason = quota.get("reason")
    if reason == "game_active_session":
        print("This game already has an active upload (limit: 1).", file=sys.stderr)
    elif reason == "owner_active_limit":
        print("Your account has reached the active upload limit (3 across all games).", file=sys.stderr)
    else:
        print("Check active uploads with: ./.builda-agent/builda upload-list --all (requires a server with recovery support).", file=sys.stderr)
    print("Retry the original unchanged ZIP to resume. Rebuilding a ZIP may create a different upload.", file=sys.stderr)
    if data.get("requestId"):
        print("Request ID: " + str(data["requestId"]), file=sys.stderr)
rows = quota.get("sessions", []) if mode == "blocked" else data.get("sessions", [])
out = sys.stderr if mode == "blocked" else sys.stdout
if not rows and mode != "blocked":
    print("No active uploads in this scope.", file=out)
    if sys.argv[2]:
        print("Run upload-list --all to see uploads for your other games.", file=out)
def date(value):
    try:
        if int(value) <= 0:
            return "unknown"
        return datetime.datetime.fromtimestamp(int(value) / 1000, datetime.timezone.utc).isoformat()
    except (ValueError, TypeError, OverflowError, OSError):
        return "unknown"
for row in rows:
    sid = str(row.get("id", ""))
    if not re.fullmatch(r"[a-zA-Z0-9_-]+", sid):
        continue
    print("Session: {}  game={}  status={}  size={} bytes".format(sid, row.get("gameId") or "(new game)", row.get("status"), row.get("expectedSize")), file=out)
    print("  Created: {}  Last activity: {}  Expires: {}".format(date(row.get("createdAt")), date(row.get("lastActivityAt")), date(row.get("expiresAt"))), file=out)
    print("  Inspect progress: ./.builda-agent/builda upload-status " + sid, file=out)
    if row.get("canCancel") is True:
        print("  To abandon this upload: ./.builda-agent/builda upload-cancel " + sid, file=out)
    else:
        print("  Cancellation is currently unavailable; inspect status before retrying.", file=out)
if rows:
    print("No uploads were canceled. After explicitly canceling an abandoned upload, retry publish.", file=out)
' "$mode" "${2:-}"
}

list_upload_sessions() {
