    pathlib.Path.cwd() / state_dir / "sdk" / "web" / "mic" / "builda-mic-worker.js",
)
mic_worker_in_project = project_mic_worker is not None
mic_worker_in_web = (web_root / "addons" / "builda" / "mic" / "web" / "builda-mic-worker.js").is_file()

mimetypes.add_type("application/wasm", ".wasm")
mimetypes.add_type("application/octet-stream", ".pck")
mimetypes.add_type("text/javascript", ".js")
mimetypes.add_type("audio/ogg", ".ogg")
mimetypes.add_type("model/gltf-binary", ".glb")
mimetypes.add_type("image/ktx2", ".ktx2")

def entry_query() -> str:
    query = {"gameId": game_id}
    if safe_area:
        query["builda_mock_safearea"] = safe_area
    return urllib.parse.urlencode(query)

entry_path = f"/index.html?{entry_query()}"
shell_path = f"/builda-dev-shell.html?{entry_query()}"

class DevHandler(SimpleHTTPRequestHandler):
    server_version = "BuildaDev/1"

    def end_headers(self):
        self.send_header("Cross-Origin-Opener-Policy", "same-origin")
        self.send_header("Cross-Origin-Embedder-Policy", "require-corp")
        self.send_header("Cross-Origin-Resource-Policy", "cross-origin")
        super().end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = posixpath.normpath(urllib.parse.unquote(parsed.path))
        if path in ("/builda-sdk.js", "/addons/builda/web/builda-sdk.js"):
            target = pathlib.Path(self.directory) / path.lstrip("/")
            if not target.is_file() and project_sdk_js is not None:
                data = project_sdk_js.read_bytes()
                self.send_response(HTTPStatus.OK)
                self.send_header("Content-Type", "text/javascript")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
        if path.startswith("/addons/builda/mic/web/") or path == "/mic/builda-mic-worker.js":
            # BuildaMic worker fallback: if missing from the web export dir, serve from the project/toolchain dir (path already normpath'd to strip ..)
            target = pathlib.Path(self.directory) / path.lstrip("/")
            candidate = first_file(
                pathlib.Path.cwd() / path.lstrip("/"),
                project_mic_worker if project_mic_worker is not None else pathlib.Path("/nonexistent"),
            )
            if not target.is_file() and candidate is not None:
                data = candidate.read_bytes()
                self.send_response(HTTPStatus.OK)
                self.send_header("Content-Type", mimetypes.guess_type(path)[0] or "application/octet-stream")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
        if assets_root is not None and (path.startswith("/audio/") or path.startswith("/res/")):
            # assets fallback: if the file is missing from the web root, serve it from the project assets source (path already normpath'd to strip ..)
            target = pathlib.Path(self.directory) / path.lstrip("/")
            candidate = assets_root / path.lstrip("/")
            if not target.is_file() and candidate.is_file():
                data = candidate.read_bytes()
                self.send_response(HTTPStatus.OK)
                self.send_header("Content-Type", mimetypes.guess_type(path)[0] or "application/octet-stream")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
        if path == "/builda-dev-shell.html":
            target = pathlib.Path(self.directory) / "builda-dev-shell.html"
            if not target.is_file() and project_shell is not None:
                data = project_shell.read_bytes()
                self.send_response(HTTPStatus.OK)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
        if path in ("", "/"):
            self.send_response(HTTPStatus.FOUND)
            self.send_header("Location", shell_path if shell_present else entry_path)
            self.end_headers()
            return
        super().do_GET()

def make_server(start_port: int):
    candidates = [0] if start_port == 0 else range(start_port, min(start_port + 21, 65536))
    last_error = None
    handler = partial(DevHandler, directory=str(web_root))
    for candidate in candidates:
        try:
            return ThreadingHTTPServer(("127.0.0.1", candidate), handler)
        except OSError as exc:
            last_error = exc
    raise SystemExit(f"could not bind localhost port {start_port}: {last_error}")

