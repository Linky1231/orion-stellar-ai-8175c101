    path = os.path.join(argv[0], "requests", argv[1] + ".json")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(dump({"nonce": argv[2], "done": argv[3] == "1", "taskId": argv[4], "updatedAt": int(time.time())}) + "\n")
