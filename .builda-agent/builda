#!/usr/bin/env bash
set -euo pipefail

# ── Project-level layout (one project = one toolchain = one version) ────────
# CLI/SKILL/VERSION are committed to Git as the project toolchain; publish.env, regenerable caches and receipts stay local;
# auth credentials (token/refresh-token) live only in $HOME/.builda-agent/.
# The old name .builda-godot-agent (pre multi-engine) is migrated automatically on the next run by legacy_project_dir_migrate / legacy_auth_migrate
# (see docs/decisions/0013).
SELF_PATH="${BASH_SOURCE[0]:-$0}"
SELF_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd -P)"
AUTH_DIR="${BUILDA_AUTH_DIR:-$HOME/.builda-agent}"
LEGACY_AUTH_DIR="$HOME/.builda-godot-agent"
TOKEN_FILE="$AUTH_DIR/token"
REFRESH_FILE="$AUTH_DIR/refresh-token"
ISSUE_TOKEN_FILE="$AUTH_DIR/issue-token"
ISSUE_REFRESH_FILE="$AUTH_DIR/issue-refresh-token"
ISSUE_ACTOR_FILE="$AUTH_DIR/issue-actor-id"
PROJECT_STATE_DIR="${BUILDA_PROJECT_STATE_DIR:-.builda-agent}"
LEGACY_PROJECT_STATE_DIR=".builda-godot-agent"
ROOT="$PROJECT_STATE_DIR"
ENV_FILE="$ROOT/publish.env"
MANIFEST="${BUILDA_MANIFEST:-builda.publish.json}"
PROJECT_FILE="${BUILDA_PROJECT_FILE:-$PROJECT_STATE_DIR/game.json}"
LEGACY_PROJECT_FILE="${BUILDA_LEGACY_PROJECT_FILE:-builda.game.json}"
VERSION="0.4.102"
RUNTIME_VERSION_FILE="$ROOT/VERSION"
SDK_VERSION_FILE="$PROJECT_STATE_DIR/sdk-version"
[ -f "$ENV_FILE" ] && . "$ENV_FILE"
BUILDA_DEFAULT_BASE="https://builda-godot-api.poni.fun"
if [[ "$BUILDA_DEFAULT_BASE" == \{\{* ]]; then
  BUILDA_DEFAULT_BASE=""
fi
BUILDA_BASE="${BUILDA_BASE:-$BUILDA_DEFAULT_BASE}"
BUILDA_ISSUE_BASE="${BUILDA_ISSUE_BASE:-$BUILDA_BASE}"
if [ -n "${BUILDA_STUDIO_API_BASE:-}" ]; then
  # Studio Worker explicitly injects the in-cluster API; external projects keep using the public address from publish.env.
  BUILDA_BASE="${BUILDA_STUDIO_API_BASE%/}"
fi
BUILDA_DEFAULT_AGENT_BASE="https://ai.builda.game"
if [[ "$BUILDA_DEFAULT_AGENT_BASE" == \{\{* ]]; then
  BUILDA_DEFAULT_AGENT_BASE="$BUILDA_BASE"
fi
BUILDA_AGENT_BASE="${BUILDA_AGENT_BASE:-$BUILDA_DEFAULT_AGENT_BASE}"
BUILDA_DEFAULT_SITE_BASE="https://builda.game"
if [[ "$BUILDA_DEFAULT_SITE_BASE" == \{\{* ]]; then
  BUILDA_DEFAULT_SITE_BASE="https://builda.game"
fi
BUILDA_SITE_ORIGIN="${BUILDA_SITE_ORIGIN:-}"
BUILDA_EFFECTIVE_SITE_BASE="${BUILDA_SITE_ORIGIN:-$BUILDA_DEFAULT_SITE_BASE}"
BUILDA_EARLY_ACCESS_URL="${BUILDA_EARLY_ACCESS_URL:-$BUILDA_EFFECTIVE_SITE_BASE/early-access}"

# Inlined into builda; Schema support adds no separately installed script.
schema_tool() {
  need_python3
  python3 - "$@" <<'PY_SCHEMA'
"""Inlined into the Unix CLI; source remains separately testable."""
import hashlib
import json
import os
import re
import sys
import tempfile
import time
import unicodedata

MAX_FILE = 2 * 1024 * 1024
IDENTIFIER = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}\Z", re.ASCII)


def fail(message):
    raise ValueError(message)


def unique_members(items):
    result = {}
    for key, value in items:
        if key in result:
            fail("schema_invalid: duplicate JSON member")
        result[key] = value
    return result


def reject_constant(_):
    fail("schema_invalid: non-JSON number")


def check_unicode(value, depth=0):
    if depth > 64:
        fail("schema_invalid: JSON nesting exceeds 64")
    if isinstance(value, str):
        value.encode("utf-8", "strict")
    elif isinstance(value, dict):
        for key, child in value.items():
            key.encode("utf-8", "strict")
            check_unicode(child, depth + 1)
    elif isinstance(value, list):
        for child in value:
            check_unicode(child, depth + 1)


def parse(text):
    value = json.loads(text, object_pairs_hook=unique_members, parse_constant=reject_constant)
    check_unicode(value)
    return value


def read(path, maximum=MAX_FILE):
    with open(path, "rb") as handle:
        raw = handle.read(maximum + 1)
    if len(raw) > maximum:
        fail("schema_limit_exceeded: manifest or receipt exceeds size limit")
    return raw.decode("utf-8-sig", "strict")


def canonical(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)


def digest(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def file_digest(path):
    result = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            result.update(block)
    return result.hexdigest()


def sync_directory(directory):
    fd = os.open(os.path.abspath(directory), os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic(path, text):
    directory = os.path.dirname(os.path.abspath(path))
    os.makedirs(directory, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".schema-write-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        sync_directory(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


MAX_SCHEMA_DEPTH = 16
MAX_SCHEMA_NODES = 1024
MAX_DEFINITION_BYTES = 16 * 1024
MAX_SCHEMA_ITEMS = 100
MAX_SCHEMA_ARRAY_BYTES = 256 * 1024
PLAIN_FIELD = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")


def child_path(path, name):
    return path + ("." + name if PLAIN_FIELD.fullmatch(name) else "[" + json.dumps(name, ensure_ascii=False) + "]")


def validate_node(node, depth, field, count, where, path):
    # where names the definition and path the node, so a limit failure points at the exact spot.
    count[0] += 1
    if depth > MAX_SCHEMA_DEPTH:
        fail("schema_invalid: %s %s: nesting depth %d exceeds limit %d (root is depth 0)" % (where, path, depth, MAX_SCHEMA_DEPTH))
    if count[0] > MAX_SCHEMA_NODES:
        fail("schema_invalid: %s %s: definition exceeds %d nodes" % (where, path, MAX_SCHEMA_NODES))
    if not isinstance(node, dict):
        fail("schema_invalid: %s %s: node must be an object" % (where, path))
    if set(node) - {"kind", "optional", "fields", "mapValue"}:
        fail("schema_invalid: %s %s: unknown node field" % (where, path))
    if ("optional" in node) != field or (field and type(node["optional"]) is not bool):
        fail("schema_invalid: %s %s: optional must be explicit only on fixed fields" % (where, path))
    kind = node.get("kind")
    if kind not in ("bool", "int64", "float64", "string", "bytes", "map"):
        fail("schema_invalid: %s %s: unsupported node kind" % (where, path))
    if kind != "map":
        if "fields" in node or "mapValue" in node:
            fail("schema_invalid: %s %s: scalar cannot contain child rules" % (where, path))
        return
    if ("fields" in node) == ("mapValue" in node):
        fail("schema_invalid: %s %s: map needs exactly fields or mapValue" % (where, path))
    if "mapValue" in node:
        validate_node(node["mapValue"], depth + 1, False, count, where, path + ".mapValue")
        return
    fields = node["fields"]
    if not isinstance(fields, dict) or not fields:
        fail("schema_invalid: %s %s: fields must be a nonempty object" % (where, path))
    for name, child in fields.items():
        if not name or len(name.encode("utf-8")) > 128 or any(unicodedata.category(c) == "Cc" for c in name):
            fail("schema_invalid: %s %s: invalid field name" % (where, child_path(path + ".fields", name)))
        validate_node(child, depth + 1, True, count, where, child_path(path + ".fields", name))


def raw_schema_size(text):
    # Full parse already checked syntax. Measure the original array including
    # whitespace, before a later rewrite can erase oversized input.
    decoder = json.JSONDecoder()
    offset = text.index("{") + 1
    while True:
        while text[offset] in " \t\r\n": offset += 1
        if text[offset] == "}": return 0
        key, offset = decoder.raw_decode(text, offset)
        while text[offset] in " \t\r\n": offset += 1
        offset += 1
        while text[offset] in " \t\r\n": offset += 1
        start = offset
        _, offset = decoder.raw_decode(text, offset)
        if key == "objectSchemas":
            return len(text[start:offset].encode("utf-8"))
        while text[offset] in " \t\r\n": offset += 1
        if text[offset] == "}": return 0
        offset += 1


def manifest_schemas(text):
    manifest = parse(text)
    if not isinstance(manifest, dict):
        fail("schema_invalid: manifest must be an object")
    schemas = manifest.get("objectSchemas", [])
    if not isinstance(schemas, list):
        fail("schema_invalid: objectSchemas must be an array")
    if len(schemas) > MAX_SCHEMA_ITEMS:
        fail("schema_limit_exceeded: objectSchemas has %d definitions, exceeds limit %d" % (len(schemas), MAX_SCHEMA_ITEMS))
    raw_size = raw_schema_size(text)
    if raw_size > MAX_SCHEMA_ARRAY_BYTES:
        fail("schema_limit_exceeded: objectSchemas is %d bytes, exceeds limit %d (256 KiB)" % (raw_size, MAX_SCHEMA_ARRAY_BYTES))
    seen = set()
    for definition in schemas:
        if not isinstance(definition, dict) or set(definition) != {"schemaId", "schemaVersion", "root"}:
            fail("schema_invalid: expected schemaId, schemaVersion and root")
        identifier, version = definition["schemaId"], definition["schemaVersion"]
        if not isinstance(identifier, str) or not IDENTIFIER.fullmatch(identifier):
            fail("schema_invalid: invalid schemaId")
        if type(version) is not int or not 1 <= version <= 4294967295:
            fail("schema_invalid: schemaVersion must be a canonical uint32 integer")
        if (identifier, version) in seen:
            fail("schema_invalid: duplicate schema id/version")
        seen.add((identifier, version))
        where = "%s@%d" % (identifier, version)
        validate_node(definition["root"], 0, False, [0], where, "root")
        if definition["root"].get("kind") != "map":
            fail("schema_invalid: %s root: root must be a map" % where)
        size = len(canonical(definition).encode("utf-8"))
        if size > MAX_DEFINITION_BYTES:
            fail("schema_limit_exceeded: %s: canonical definition is %d bytes, exceeds limit %d (16 KiB)" % (where, size, MAX_DEFINITION_BYTES))
    schemas.sort(key=lambda item: (item["schemaId"], item["schemaVersion"]))
    size = len(canonical(schemas).encode("utf-8"))
    if size > MAX_SCHEMA_ARRAY_BYTES:
        fail("schema_limit_exceeded: canonical objectSchemas is %d bytes, exceeds limit %d (256 KiB)" % (size, MAX_SCHEMA_ARRAY_BYTES))
    return schemas


def journal_path(root):
    return os.path.join(root, "last-schema-operation.json")


def load(root):
    operation = parse(read(journal_path(root), 16 * 1024 * 1024))
    working = os.path.abspath(os.path.join(root, "last-schema-manifest.json"))
    if not isinstance(operation, dict) or operation.get("journalVersion") != 1 or operation.get("working") != working:
        fail("schema_operation_invalid: invalid operation receipt")
    return operation


def save(root, operation):
    atomic(journal_path(root), canonical(operation))


def expected_receipt(game, schemas_json):
    return {"formatVersion": 1, "gameId": game, "status": "registered", "batchDigest": digest(schemas_json),
            "schemas": [{"schemaId": item["schemaId"], "schemaVersion": item["schemaVersion"],
                         "definitionDigest": digest(canonical(item))} for item in parse(schemas_json)]}


def begin(root, source, base, target, action, zip_path):
    if os.path.exists(journal_path(root)):
        previous = load(root)
        if previous.get("status") == "failed":
            # A terminal Schema error does not undo an already created game.
            # Corrected input starts an update against that confirmed identity.
            if previous.get("gameId"):
                if previous["apiBase"] != base.rstrip("/") or (target and target != previous["gameId"]):
                    fail("schema_operation_pending: confirmed game identity changed")
                target = previous["gameId"]
            atomic(os.path.join(root, "last-schema-failed.json"), canonical(previous))
        else:
            if previous["source"] != os.path.abspath(source) or previous["apiBase"] != base.rstrip("/") or previous["action"] != action:
                fail("schema_operation_pending: resume original command, manifest and API environment")
            if target and target != (previous["gameId"] or previous["target"]):
                fail("schema_operation_pending: game binding changed")
            return previous["working"]
    text = read(source)
    schemas = manifest_schemas(text)
    if action in ("schemas", "update-draft") and not target:
        fail("schema_invalid: bind this project to a game before schemas upload")
    operation = {"journalVersion": 1, "status": "pending", "action": action,
                 "source": os.path.abspath(source), "apiBase": base.rstrip("/"),
                 "target": target, "gameId": target, "authorId": "", "original": text,
                 "originalDigest": digest(text), "schemasJson": canonical(schemas),
                 "working": os.path.abspath(os.path.join(root, "last-schema-manifest.json")),
                 "zip": os.path.abspath(zip_path) if zip_path else "", "zipDigest": file_digest(zip_path) if zip_path else "",
                 "prepared": False, "gameRequest": "", "gameOperationId": "", "gameResult": None, "schemaReceipt": None,
                 "studioOperation": os.environ.get("BUILDA_PUBLISH_OPERATION_ID", "")}
    save(root, operation)
    atomic(operation["working"], text)
    return operation["working"]


def schema_result(root, operation, status, response_path):
    try:
        response = parse(read(response_path))
    except (ValueError, UnicodeError):
        response = {}
    if not isinstance(response, dict): response = {}
    if status != 200:
        reason = response.get("reason", "")
        if status == 404 and reason != "game_not_found": reason = "schema_contract_unsupported"
        if status >= 500 or status == 429: reason = "schema_registry_unavailable"
        if not reason: reason = "schema_registry_unavailable"
        if reason in ("schema_invalid", "schema_limit_exceeded", "schema_version_conflict", "schema_contract_unsupported", "game_not_found"):
            operation["status"] = "failed"
            save(root, operation)
        fail(reason + ": HTTP " + str(status))
    expected = expected_receipt(operation["gameId"], operation["schemasJson"])
    items = response.get("schemas")
    typed_items = isinstance(items, list) and all(isinstance(item, dict) and type(item.get("schemaVersion")) is int for item in items)
    if not typed_items or type(response.get("formatVersion")) is not int or any(response.get(key) != value for key, value in expected.items()):
        fail("schema_contract_unsupported: registration receipt differs from frozen input")
    operation["schemaReceipt"] = expected
    save(root, operation)


def record_game_result(root, operation, response_path):
    result = parse(read(response_path))
    game = result.get("body", {}).get("game", {})
    game_id = game.get("id")
    version = game.get("versionId") or game.get("currentVersionId") or game.get("draftVersionId")
    if not isinstance(game_id, str) or not IDENTIFIER.fullmatch(game_id) or not isinstance(version, str) or not version:
        fail("schema_operation_pending: missing gameId/versionId; replay the same request")
    if operation["target"] and operation["target"] != game_id:
        fail("schema_operation_pending: game response identity mismatch")
    operation["gameId"], operation["versionId"], operation["gameResult"] = game_id, version, result
    save(root, operation)


def bind(root, operation, project_file):
    if not operation["gameResult"]: return
    manifest = parse(operation.get("preparedManifest", operation["original"]))
    binding = {"provider": "builda-h5", "gameId": operation["gameId"], "title": manifest.get("title", ""),
               "lastVersionId": operation["versionId"], "updatedAt": int(time.time() * 1000)}
    atomic(project_file, canonical(binding))
    for name, value in (("last-game-id", operation["gameId"]), ("last-draft-id", operation["gameId"]), ("last-version-id", operation["versionId"])):
        atomic(os.path.join(root, name), value)
    atomic(os.path.join(root, "last-draft.json"), canonical(operation["gameResult"]))


def display_path(path):
    relative = os.path.relpath(path)
    return path if relative.startswith("..") else relative


def finish(root, operation):
    if operation["schemaReceipt"] is None or (operation["action"] != "schemas" and operation["gameResult"] is None):
        fail("schema_operation_pending: required steps are incomplete")
    operation["status"] = "completed"
    save(root, operation)
    if operation["action"] != "schemas" and os.path.exists(operation["source"]):
        if digest(read(operation["source"])) == operation["originalDigest"]:
            working = read(operation["working"])
            atomic(operation["source"], working)
            if working != operation["original"]:
                detail = " with build and H5 Bundle fields" if operation["zip"] else ""
                print("Updated %s%s." % (display_path(operation["source"]), detail), file=sys.stderr)
        else:
            print("schema-resume=completed frozen input; newer manifest edits were not published", file=sys.stderr)
    print(canonical(operation["gameResult"] or operation["schemaReceipt"]))
    os.unlink(journal_path(root))
    sync_directory(root)


def main(args):
    command, root = args[:2]
    if command == "validate":
        manifest_schemas(read(root)); return
    if command == "golden":
        print(canonical(expected_receipt("game-example", canonical(manifest_schemas(read(root)))))); return
    if command == "mode":
        if os.path.exists(journal_path(root)) and load(root).get("status") != "failed":
            print("active"); return
        print("active" if manifest_schemas(read(args[2])) else "inactive"); return
    if command == "begin":
        print(begin(root, *args[2:7])); return
    operation = load(root)
    if command == "field":
        value = operation.get(args[2])
        if type(value) is bool: print("1" if value else "0")
        elif value is not None: print(canonical(value) if isinstance(value, (dict, list)) else value)
    elif command == "prepared":
        operation["prepared"] = True
        operation["preparedManifest"] = read(operation["working"])
        save(root, operation)
    elif command == "preflight-failed":
        if operation["gameRequest"] or operation["schemaReceipt"]:
            fail("schema_operation_pending: operation already has remote effects")
        operation["status"] = "failed"
        save(root, operation)
    elif command == "restore-working":
        atomic(operation["working"], operation.get("finalManifest", operation.get("preparedManifest", operation["original"])))
    elif command == "authorize":
        author, binding = args[2:4]
        if not author or (operation["authorId"] and author != operation["authorId"]):
            fail("schema_operation_pending: resume with original author")
        if binding and binding != operation["gameId"]:
            fail("schema_operation_pending: project binding changed")
        if operation["studioOperation"] != os.environ.get("BUILDA_PUBLISH_OPERATION_ID", ""):
            fail("schema_operation_pending: publish operation context changed")
        operation["authorId"] = author; save(root, operation)
    elif command == "check-zip":
        if operation["zip"] and file_digest(operation["zip"]) != operation["zipDigest"]:
            fail("schema_operation_pending: frozen build zip changed")
    elif command == "schema-body":
        if not operation["gameId"]: fail("schema_invalid: gameId is not yet known")
        body = {"formatVersion": 1, "gameId": operation["gameId"], "objectSchemas": parse(operation["schemasJson"])}
        path = os.path.join(root, "last-schema-request.json")
        atomic(path, canonical(body)); print(path)
    elif command == "schema-result":
        schema_result(root, operation, int(args[2]), args[3])
    elif command == "game-request":
        operation["gameRequest"], operation["gameOperationId"] = read(args[2]), args[3]
        operation["gameAction"] = "update" if operation["target"] else "create"
        operation["finalManifest"] = read(operation["working"])
        save(root, operation)
    elif command == "game-body":
        path = os.path.join(root, "last-schema-game-request.json")
        atomic(path, operation["gameRequest"]); print(path)
    elif command == "game-result":
        record_game_result(root, operation, args[2])
    elif command == "bind":
        bind(root, operation, args[2])
    elif command == "finish":
        finish(root, operation)
    else:
        fail("unknown schema operation")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (ValueError, UnicodeError, OSError, RecursionError, TypeError, KeyError, AttributeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)

PY_SCHEMA
}

schema_register_saved() {
  local payload response_path="$ROOT/last-schema-response.json"
  payload="$(schema_tool schema-body "$ROOT")"
  if ! authenticated_http_response "register object schemas" -X POST "$BUILDA_BASE/api/v1/agent/object-schemas/register" -H 'Content-Type: application/json' --data-binary "@$payload"; then
    echo "schema=pending; retry the same command to resume" >&2
    return 1
  fi
  printf '%s' "$AUTH_HTTP_BODY" > "$response_path"
  schema_tool schema-result "$ROOT" "$AUTH_HTTP_STATUS" "$response_path" || return $?
  echo "schema=registered" >&2
}

schema_prepare_game_request() {
  local working="$1" target="$2" zip payload used game_action operation
  schema_tool check-zip "$ROOT"
  zip="$(schema_tool field "$ROOT" zip)"
  if [ -n "$zip" ]; then BUILDA_MANIFEST="$working" BUILDA_SCHEMA_STAGING=1 "$0" upload-build "$zip" >&2; fi
  payload="$ROOT/last-schema-game-request.json"
  used="$(write_draft_request_payload "$working" "$payload" "$target")"
  warn_deprecated_display_fields "$used"
  game_action=create
  [ -z "$target" ] || game_action=update
  operation="${BUILDA_PUBLISH_OPERATION_ID:-}"
  [ -n "$operation" ] || operation="$(draft_idempotency_key "$game_action" "$target" "$payload")"
  schema_tool game-request "$ROOT" "$payload" "$operation"
}

schema_send_game_request() {
  local payload game_action operation response endpoint=game/create
  payload="$(schema_tool game-body "$ROOT")"
  game_action="$(schema_tool field "$ROOT" gameAction)"
  operation="$(schema_tool field "$ROOT" gameOperationId)"
  [ "$game_action" = create ] || endpoint=game/updatedraft
  if [ -n "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then
    response="$(authenticated_http_request "schema publish draft" -X POST "$(cmd_url "$endpoint")" -H "Idempotency-Key: $operation" -H "X-Builda-Studio-Publish-Id: $operation" -H "X-Builda-Publish-Lease-Id: ${BUILDA_PUBLISH_LEASE_ID:?missing publish lease}" -H "X-Builda-Publish-Attempt: ${BUILDA_PUBLISH_ATTEMPT:?missing publish attempt}" -H 'Content-Type: application/json' --data-binary "@$payload")"
  else
    response="$(authenticated_http_request "schema publish draft" -X POST "$(cmd_url "$endpoint")" -H "Idempotency-Key: $operation" -H 'Content-Type: application/json' --data-binary "@$payload")"
  fi
  cmd_response_ok_or_exit "schema publish draft" "$response"
  printf '%s' "$response" > "$ROOT/last-schema-game-response.json"
  schema_tool game-result "$ROOT" "$ROOT/last-schema-game-response.json"
  schema_tool bind "$ROOT" "$PROJECT_FILE"
}

schema_publish_locked() {
  local action="$1" source="$2" target="$3" zip="$4"
  local working owner identity operation
  python3 -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)' || { echo "schema_operation_busy: another publish is running in this project" >&2; return 1; }
  if [ "$action" = create-draft ] && [ -n "$(project_game_id)" ] && [ ! -f "$ROOT/last-schema-operation.json" ]; then
    echo "Project already has a game binding; use update-draft." >&2
    return 1
  fi
  working="$(schema_tool begin "$ROOT" "$source" "$BUILDA_BASE" "$target" "$action" "$zip")"
  schema_tool restore-working "$ROOT"
  if [ "$(schema_tool field "$ROOT" prepared)" != "1" ]; then
    if [ "$action" != schemas ]; then
      # These legacy helpers may exit. Isolate them so a local validation
      # failure releases the frozen input without losing the operation lock.
      if (
        sync_online_compatibility_revision "$working" || exit $?
        preflight_manifest_for_draft "$working" || exit $?
        inject_sdk_version "$working" || exit $?
      ); then :; else
        schema_tool preflight-failed "$ROOT"
        return 1
      fi
    fi
    schema_tool prepared "$ROOT"
  fi
  need_token
  identity="$(authenticated_http_request whoami "$BUILDA_BASE/api/v1/agent/whoami")"
  owner="$(printf '%s' "$identity" | json_field userId)"
  schema_tool authorize "$ROOT" "$owner" "$(project_game_id)"
  target="$(schema_tool field "$ROOT" target)"
  if [ -n "$(schema_tool field "$ROOT" gameResult)" ]; then
    schema_tool bind "$ROOT" "$PROJECT_FILE"
  elif [ -n "$target" ] && [ -z "$(schema_tool field "$ROOT" schemaReceipt)" ]; then
    schema_register_saved
  fi
  if [ "$action" != schemas ] && [ -z "$(schema_tool field "$ROOT" gameResult)" ]; then
    if [ -z "$(schema_tool field "$ROOT" gameRequest)" ]; then schema_prepare_game_request "$working" "$target"; fi
    schema_send_game_request
  fi
  if [ -z "$(schema_tool field "$ROOT" schemaReceipt)" ]; then
    echo "schema=pending gameId=$(schema_tool field "$ROOT" gameId) versionId=$(schema_tool field "$ROOT" versionId)" >&2
    schema_register_saved
  fi
  operation="$(schema_tool field "$ROOT" gameOperationId)"
  if [ -n "$operation" ] && [ -z "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then complete_draft_operation "$operation"; fi
  schema_tool finish "$ROOT"
  echo "schema=registered sync=ok" >&2
}

schema_publish() {
  need_python3
  mkdir -p "$ROOT"
  # The inherited open-file description holds flock until this function exits,
  # including failures or process termination; no stale PID lock is needed.
  schema_publish_locked "$@" 9>"$ROOT/last-schema-operation.lock"
}


