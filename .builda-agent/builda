if "builda-sdk.js" not in index_html:
    if engine == "godot":
        raise SystemExit("index.html does not load builda-sdk.js. Ensure Godot Web export head include injects the SDK script.")
    if engine == "unity":
        raise SystemExit('index.html does not load builda-sdk.js. Select the Builda WebGL Template (Player Settings -> Resolution and Presentation; installed by builda sdk install), or add <script src="builda-sdk.js"></script> to your custom template head, then rebuild.')
    raise SystemExit('index.html does not load builda-sdk.js. Add <script src="builda-sdk.js"></script> to the HTML head and rebuild.')
if wasm_size > max_wasm_memory:
    raise SystemExit(f"wasm file exceeds 1GiB: {wasm_size} bytes")

print("bundle=ok")
print("bundle-engine=" + engine)
print("sdk-injected=ok")

if engine == "godot":
    # Godot-specific: threads/COI export template variables and Emscripten memory regexes (skipped for h5; false positives uncontrollable)
    threads_enabled = bool(re.search(r"\bGODOT_THREADS_ENABLED\s*=\s*true\b", index_html) or re.search(r"\bGODOT_THREADS_ENABLED\s*=\s*true\b", index_js))
    coi_enabled = bool(re.search(r"\bensureCrossOriginIsolationHeaders\s*:\s*true\b", index_html) or re.search(r"\bensureCrossOriginIsolationHeaders\s*:\s*true\b", index_js))
    if webview_compat:
