def cmd_request_done_for_task(argv):
    # argv: ledgerDir taskId → marks the request that produced taskId as done
    d = os.path.join(argv[0], "requests")
    if not os.path.isdir(d):
        return
    for name in os.listdir(d):
        path = os.path.join(d, name)
        try:
            r = load(path)
        except Exception:
            continue
        if r.get("taskId") == argv[1] and not r.get("done"):
            r["done"] = True
            with open(path + ".tmp", "w", encoding="utf-8") as fh:
                fh.write(dump(r) + "\n")
            os.replace(path + ".tmp", path)

def cmd_list(argv):
    d, limit = os.path.join(argv[0], "tasks"), int(argv[1])
    records = []
    if os.path.isdir(d):
        for name in os.listdir(d):
            if name.endswith(".json"):
                try:
                    records.append(load(os.path.join(d, name)))
                except Exception:
                    pass
    if len(argv) > 3 and argv[3]:
        records = [r for r in records if r.get("genType") == argv[3]]
    records.sort(key=lambda r: r.get("createdAt", 0), reverse=True)
    if len(argv) > 2 and argv[2] == "json":
        for r in records:
            if isinstance(r.get("params"), str):
                r["params"] = params_obj(r["params"])
        print(dump(records[:limit]))
        return
    for r in records[:limit]:
        prompt = str(r.get("prompt", "")).replace("\n", " ")
        prompt = prompt[:60] + ("…" if len(prompt) > 60 else "")
        files = ",".join(r.get("files") or [])
        params = f" params={r['params']}" if r.get("params") else ""
        print(f"task={r.get('taskId','')} type={r.get('genType','')} model={r.get('model','') or '-'} status={r.get('status','')} "
              f"energy-cost={r.get('energyCost','')}{params} files={files} prompt={json.dumps(prompt, ensure_ascii=False)}")
    if not records:
        print("tasks=0")

def cmd_estimate(argv):
    # argv: modelsJson genType model count -> "model<TAB>estimate<TAB>mode"; image estimates by requested count, others use estimatedMax.
    data, gen_type, want = load(argv[0]), argv[1], argv[2]
    count = int(argv[3]) if (argv[3] or "").isdigit() else 1
    for g in data.get("groups") or []:
        if g.get("genType") != gen_type:
            continue
        models = g.get("models") or []
        pick = next((m for m in models if want and m.get("model") == want), None)
        if pick is None and not want:
            pick = next((m for m in models if m.get("isDefault")), models[0] if models else None)
        if pick:
            p = pick.get("pricing") or {}
            est = pick.get("estimatedMax") or p.get("maxCost") or p.get("unitCost") or 0
            if gen_type in ("image", "audio", "music") and p.get("mode") in ("count", "second") and p.get("unitCost"):
                unit = p.get("unitCount") or 1
                units = count
                if p.get("mode") == "second":
                    units *= (pick.get("limits") or {}).get("maxDurationSec") or 1
                est = (p["unitCost"] * units + unit - 1) // unit
                est = max(est, p.get("minCost") or 0)
                if p.get("maxCost"): est = min(est, p["maxCost"])
            print(f"{pick.get('model','')}\t{est}\t{p.get('mode','')}")
            return
    raise SystemExit(f"model not available for {gen_type}: {want or '(default)'}")

def cmd_models(argv):
