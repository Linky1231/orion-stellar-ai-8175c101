bundle_check() {
  local webview_compat="${BUILDA_WEBVIEW_COMPAT:-0}" zip="" engine=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --webview-compatible)
        webview_compat="1"
        shift
        ;;
      --engine)
        engine="${2:-}"
        shift 2
        ;;
      --engine=*)
        engine="${1#--engine=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        echo "Unknown bundle-check option: $1" >&2
        echo "Usage: builda bundle-check [--engine godot|h5|unity] [--webview-compatible] <zip>" >&2
        exit 1
        ;;
      *)
        zip="$1"
        shift
        break
        ;;
    esac
  done
  [ -n "$zip" ] || zip="${1:-}"
  [ -f "$zip" ] || { echo "zip file required" >&2; exit 1; }
  [ -n "$engine" ] || engine="$(manifest_engine "$MANIFEST")"
  case "$engine" in
    godot|h5|unity) ;;
    *) echo "bundle-check engine must be godot, h5 or unity: $engine" >&2; exit 1 ;;
  esac
  need_python3
  # Validation rules match backend buildzip (single source of truth: h5_bundle_spec.md Appendix B):
  # godot = three-piece set + Godot denylist + threads/COI/wasm memory; h5 = entry only + common denylist +
  # sourcemap/node_modules banned, Godot-specific regexes skipped; unity = Build/ four-piece set (suffix match,
  # allowing .unityweb) + Unity project denylist + StreamingAssets extension exemption, banned rules same as h5.
  python3 - "$zip" "$webview_compat" "$engine" <<'PY'
import pathlib
import re
import stat
import sys
import zipfile

zip_path = sys.argv[1]
webview_compat = sys.argv[2] == "1"
engine = sys.argv[3]
max_wasm_memory = 1 << 30
required = {"index.html", "index.js", "index.wasm", "index.pck"} if engine == "godot" else {"index.html"}
# Extension allowlist: matches backend buildzip godot/h5/unity sets (h5_bundle_spec.md Appendix B; change all three places together)
godot_ext = {
    ".html", ".js", ".wasm", ".pck",
    ".png", ".jpg", ".jpeg", ".webp", ".svg",
    ".ico", ".json", ".css", ".txt", ".md",
}
h5_ext = godot_ext | {
    ".mjs", ".woff", ".woff2", ".ttf", ".otf",
    ".mp3", ".ogg", ".wav", ".m4a", ".mp4", ".webm",
    ".avif", ".gif", ".bin", ".dat",
    ".glsl", ".frag", ".vert", ".atlas", ".fnt",
    ".xml", ".gltf", ".glb", ".ktx2", ".basis",
}
unity_ext = h5_ext | {".unityweb", ".data"}
allowed_ext = {"godot": godot_ext, "h5": h5_ext, "unity": unity_ext}[engine]
# unity Build/ four-piece set (file names contain the build name, so match prefix+suffix only, Appendix B.7)
unity_found = {"loader.js": False, "framework.js": False, "wasm": False, "data": False}
found = set()
forbidden = []
bad_ext = []
sdk_found = False
index_html = ""
index_js = ""
wasm_size = 0

def clean_name(name: str) -> str:
    clean = name[2:] if name.startswith("./") else name
    clean = clean.rstrip("/")
    pure = pathlib.PurePosixPath(clean)
    if name.startswith("/") or "\\" in name or ":" in name or ".." in pure.parts:
        raise SystemExit(f"Unsafe zip path: {name}")
    return clean

with zipfile.ZipFile(zip_path) as z:
    infos = z.infolist()
    if len(infos) > 20000:
        raise SystemExit("Too many ZIP entries: max 20000 (files and directories)")
    has_index_js = False
    file_count = 0
    total_uncompressed = 0
    for info in infos:
        if info.is_dir():
            continue
        file_count += 1
        if file_count > 10000:
            raise SystemExit("Too many bundle files: max 10000")
        if info.file_size > 768 * 1024 * 1024:
            raise SystemExit(f"Bundle file exceeds 768MiB uncompressed: {info.filename}")
        total_uncompressed += info.file_size
        if total_uncompressed > 1024 * 1024 * 1024:
            raise SystemExit("Bundle exceeds 1GiB total uncompressed size")
        clean = clean_name(info.filename)
        mode = (info.external_attr >> 16) & 0o170000
        if mode == stat.S_IFLNK:
            raise SystemExit(f"Symlink is forbidden: {clean}")
        parts = pathlib.PurePosixPath(clean).parts
        name = pathlib.PurePosixPath(clean).name
        suffix = pathlib.PurePosixPath(clean).suffix.lower()
        if clean in required:
            found.add(clean)
        if clean == "index.js":
            has_index_js = True
        if clean in {"addons/builda/web/builda-sdk.js", "builda-sdk.js"}:
            sdk_found = True
        if suffix == ".wasm":
            wasm_size = max(wasm_size, info.file_size)
        if clean == "addons/builda/web/builda-sdk.d.ts" or name.endswith(".d.ts") or name == "builda-dev-shell.html":
            forbidden.append(clean)
        if name in {"project.godot", "export_presets.cfg", ".env"} or name.endswith(".import"):
            forbidden.append(clean)
        if any(part in {".godot", ".git", ".svn", ".hg", "__MACOSX"} for part in parts):
            forbidden.append(clean)
        if engine != "godot":
            if name.endswith(".map"):
                forbidden.append(clean + " (sourcemap leaks sources; disable sourcemaps and rebuild)")
            if "node_modules" in parts:
                forbidden.append(clean + " (node_modules must not be zipped)")
        if engine == "unity":
            if name.endswith((".meta", ".csproj", ".sln", ".unity")):
                forbidden.append(clean + " (Unity project/editor files must not be zipped)")
            if any(part in {"Library", "Temp", "Obj", "ProjectSettings"} for part in parts):
                forbidden.append(clean + " (Unity project directories must not be zipped)")
            if clean.startswith("Build/"):
                if clean.endswith(".loader.js"):
                    unity_found["loader.js"] = True
                elif clean.endswith((".framework.js", ".framework.js.unityweb")):
                    unity_found["framework.js"] = True
                elif clean.endswith((".wasm", ".wasm.unityweb")):
                    unity_found["wasm"] = True
                elif clean.endswith((".data", ".data.unityweb")):
                    unity_found["data"] = True
        # unity StreamingAssets/ skips the extension allowlist (AssetBundles conventionally often lack extensions, Appendix B.3);
        # banned list/symlinks/zip slip are still enforced
        streaming_exempt = engine == "unity" and clean.startswith("StreamingAssets/")
        if not streaming_exempt and suffix not in allowed_ext:
            bad_ext.append(clean)
    missing = sorted(required - found)
    if missing:
        raise SystemExit("Missing root " + ", ".join(missing))
    if engine == "unity":
        missing_unity = sorted(k for k, ok in unity_found.items() if not ok)
        if missing_unity:
