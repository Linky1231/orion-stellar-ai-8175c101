write_draft_request_payload() {
  local src="$1" dest="$2" game_id="${3:-}" used=""
  if command -v python3 >/dev/null 2>&1; then
    used="$(python3 - "$src" "$dest" "$game_id" <<'PY'
import json
import sys

src, dest, game_id = sys.argv[1:4]
with open(src, "r", encoding="utf-8") as f:
    data = json.load(f)
if not isinstance(data, dict):
    raise SystemExit("builda.publish.json must contain a JSON object.")
used = []
cover = data.get("coverUrl")
if isinstance(cover, str) and cover.strip():
    used.append("coverUrl")
if "advert" in data:
    used.append("advert")
if "images" in data:
    used.append("images")
for key in ("coverUrl", "advert", "images", "objectSchemas"):
    data.pop(key, None)
if game_id:
    data["id"] = game_id
with open(dest, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, separators=(",", ":"))
if used:
    print(",".join(used))
PY
)" || return 1
    printf '%s' "$used"
    return 0
  fi
  if command -v jq >/dev/null 2>&1; then
    local cover
    cover="$(jq -r '.coverUrl // empty' "$src")" || return 1
    [ -n "$cover" ] && used="coverUrl"
    if [ "$(jq -r 'has("advert")' "$src")" = "true" ]; then
      used="${used:+$used,}advert"
    fi
    if [ "$(jq -r 'has("images")' "$src")" = "true" ]; then
      used="${used:+$used,}images"
    fi
	if [ -n "$game_id" ]; then
		jq --arg id "$game_id" 'del(.coverUrl, .advert, .images, .objectSchemas) | .id=$id' "$src" > "$dest" || return 1
	else
		jq 'del(.coverUrl, .advert, .images, .objectSchemas)' "$src" > "$dest" || return 1
	fi
    printf '%s' "$used"
    return 0
  fi
  echo "create-draft/update-draft require jq or python3 to omit deprecated CYSJ display fields from the request." >&2
  return 1
}

validate_manifest_metadata() {
  local file="$1"
  [ -f "$file" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$file" <<'PY'
import json
import sys

contract = json.loads(r'''{"categories":["action","strategy","rolePlay","plot","adventure","sandBox","survival","pzzle","mystery","leisure","simulation","yangCheng","card","desktop","tower","rogueLike","shoot","speed","sport","fangZhi","music","dress","other","cooperation","moba","asymmetric","party","fight"],"coverKinds":["palette","image"],"engines":["godot","h5","unity"],"limits":{"descriptionBytes":600,"taglineBytes":90,"tags":5,"titleBytes":48},"orientations":["landscape","portrait"]}''')
path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
if not isinstance(data, dict):
    raise SystemExit("builda.publish.json must contain a JSON object.")

def utf8_len(value):
    return len(value.encode("utf-8"))

def require_string(key, *, required=False, max_bytes=None):
    value = data.get(key)
    if not isinstance(value, str):
        raise SystemExit(f"{key} must be a string.")
    if required and not value:
        raise SystemExit(f"{key} is required.")
    if max_bytes is not None and utf8_len(value) > max_bytes:
        raise SystemExit(f"{key} must be at most {max_bytes} UTF-8 bytes.")
    return value

limits = contract["limits"]
require_string("title", required=True, max_bytes=limits["titleBytes"])
require_string("tagline", max_bytes=limits["taglineBytes"])
require_string("desc", max_bytes=limits["descriptionBytes"])

for key, contract_key in (
    ("category", "categories"),
    ("orientation", "orientations"),
    ("coverKind", "coverKinds"),
):
    value = require_string(key, required=True)
    allowed = contract[contract_key]
    if value not in allowed:
        raise SystemExit(f"{key} must be one of: {', '.join(allowed)}; got {value!r}.")

engine = data.get("engine", "")
if not isinstance(engine, str):
    raise SystemExit("engine must be a string.")
if engine and engine not in contract["engines"]:
    raise SystemExit(f"engine must be one of: {', '.join(contract['engines'])}; got {engine!r}.")

tags = data.get("tags", [])
if not isinstance(tags, list) or any(not isinstance(tag, str) for tag in tags):
    raise SystemExit("tags must be an array of strings.")
if len(tags) > limits["tags"]:
    raise SystemExit(f"tags supports at most {limits['tags']} entries.")
PY
}

