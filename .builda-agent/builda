    refresh_grant >/dev/null 2>&1 || true
  fi
  if [ ! -f "$TOKEN_FILE" ]; then
    echo "No agent grant. Run: builda auth" >&2
    auth_recovery_hint >&2
    exit 1
  fi
}

token() { cat "$TOKEN_FILE"; }

builda_cmd() {
  if command -v builda >/dev/null 2>&1; then
    printf 'builda'
  else
    printf './%s/builda' "$ROOT"
  fi
}

auth_recovery_hint() {
  local cli
  cli="$(builda_cmd)"
  if [ -f "$REFRESH_FILE" ]; then
    echo "auth-next=retry the failed command; this CLI refreshes the short agent grant automatically when the saved agent authorization is still valid."
  else
