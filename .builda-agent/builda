    min_score = board["minScore"]
    max_score = board["maxScore"]
    if not isinstance(rank_id, str) or rank_id != rank_id.strip() or not rank_id_re.fullmatch(rank_id):
        print(f"rankBoards[{i}].rankId must match [A-Za-z0-9_-] and be 1-64 bytes without surrounding whitespace.", file=sys.stderr)
        raise SystemExit(1)
    if rank_id in seen:
        print(f"rankBoards rankId duplicated: {rank_id}", file=sys.stderr)
        raise SystemExit(1)
    seen.add(rank_id)
    if not isinstance(display_name, str) or display_name != display_name.strip() or not display_name or len(display_name.encode("utf-8")) > 64:
        print(f"rankBoards[{i}].displayName must be non-empty UTF-8 up to 64 bytes without surrounding whitespace.", file=sys.stderr)
        raise SystemExit(1)
    if sort_type not in {"asc", "desc"}:
        print(f"rankBoards[{i}].sortType must be asc or desc.", file=sys.stderr)
        raise SystemExit(1)
    if cycle_type not in {"day", "week", "month", "forever"}:
        print(f"rankBoards[{i}].cycleType must be day, week, month, or forever.", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(min_score, int) or isinstance(min_score, bool) or not isinstance(max_score, int) or isinstance(max_score, bool):
        print(f"rankBoards[{i}].minScore and maxScore must be integers.", file=sys.stderr)
        raise SystemExit(1)
    if min_score < score_min or max_score > score_max or min_score > max_score:
        print(f"rankBoards[{i}] score bounds must be ordered and within the supported range [-9999999999, 9999999999].", file=sys.stderr)
        raise SystemExit(1)
PY
}

