  # if it differs (e.g. an old Chinese block), replace the marker block in place, keeping content outside it and its position; if the end marker is missing, do nothing.
  strip_agents_md_block "$LEGACY_AGENTS_BLOCK_BEGIN" "$LEGACY_AGENTS_BLOCK_END" || true
  local block current
  block="$(agents_md_block)"
  if [ -f AGENTS.md ] && grep -qF "$AGENTS_BLOCK_BEGIN" AGENTS.md; then
    grep -qF "$AGENTS_BLOCK_END" AGENTS.md || return 0
    current="$(awk -v b="$AGENTS_BLOCK_BEGIN" -v e="$AGENTS_BLOCK_END" '
      index($0, b) {on=1}
      on {sub(/\r$/, ""); print}
      on && index($0, e) {exit}
    ' AGENTS.md)"
    [ "$current" = "$block" ] && return 0
    printf '%s\n' "$block" > AGENTS.md.builda-block
    awk -v b="$AGENTS_BLOCK_BEGIN" -v e="$AGENTS_BLOCK_END" -v f="AGENTS.md.builda-block" '
      !skip && index($0, b) {while ((getline line < f) > 0) print line; close(f); skip=1; next}
      skip && index($0, e) {skip=0; next}
      !skip {print}
    ' AGENTS.md > AGENTS.md.builda-tmp && mv AGENTS.md.builda-tmp AGENTS.md
    rm -f AGENTS.md.builda-block
    return 0
  fi
  {
    [ -s AGENTS.md ] && printf '\n'
    printf '%s\n' "$block"
  } >> AGENTS.md
}

