# mock SDK fallback lookup order: web export dir -> Godot addon (addons/builda/web/) ->
# HTML5/Unity toolchain location (<state_dir>/sdk/web/)
def first_file(*candidates):
    for c in candidates:
        if c.is_file():
            return c
    return None

project_sdk_js = first_file(
    pathlib.Path.cwd() / "addons" / "builda" / "web" / "builda-sdk.js",
    pathlib.Path.cwd() / state_dir / "sdk" / "web" / "builda-sdk.js",
)
sdk_present = (web_root / "addons" / "builda" / "web" / "builda-sdk.js").is_file() or (web_root / "builda-sdk.js").is_file() or project_sdk_js is not None
# The test shell is installed into the project with the mock SDK and is absent from the web export; serve it from the project dir as a fallback
project_shell = first_file(
    pathlib.Path.cwd() / "addons" / "builda" / "web" / "builda-dev-shell.html",
    pathlib.Path.cwd() / state_dir / "sdk" / "web" / "builda-dev-shell.html",
