# Embedded in the official CLI. Grants and response bodies remain in memory.
import argparse
import json
import pathlib
import sys
import urllib.error
import urllib.request


class DiagnosticNoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class DiagnosticParser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(1, "BUILDA_DIAGNOSTICS_INVALID_ARGUMENTS\n")


def main(base, token_path, project_file, argv):
    parser = DiagnosticParser(prog='builda diagnostics')
    parser.add_argument('source', choices=['private-kv', 'player-data'])
    parser.add_argument('kind', choices=['data', 'logs'])
    parser.add_argument('--role-id')
    parser.add_argument('--limit', type=int)
    parser.add_argument('--bundle-version')
    parser.add_argument('--game-id')
    parser.add_argument('--json', action='store_true', required=True)
    parser.add_argument('--key', action='append')
    parser.add_argument('--cursor')
    parser.add_argument('--from', dest='from_time')
    parser.add_argument('--to', dest='to_time')
    parser.add_argument('--operation', choices=['read', 'update', 'clear'])
    parser.add_argument('--ctx-id')
    args = parser.parse_args(argv)
    if args.source == 'runtime-errors':
        if args.kind != 'logs' or any(v is not None for v in [args.key,args.cursor,args.from_time,args.to_time,args.operation,args.ctx_id]):
            raise ValueError('invalid runtime-errors parameters')
        if args.limit is not None and not 1 <= args.limit <= 200:
            raise ValueError('invalid limit')
    elif not args.role_id or args.bundle_version is not None or (args.limit is not None and not (args.source == 'player-data' and args.kind == 'logs')):
        raise ValueError('role-id required; runtime error filters unavailable')
    if args.source == 'player-data' and args.kind == 'logs':
        if args.key is not None or args.cursor is not None or args.operation == 'clear' or (args.limit is not None and not 1 <= args.limit <= 200):
            raise ValueError('invalid player-data log parameters')
    binding = json.loads(pathlib.Path(project_file).read_text(encoding='utf-8'))
    game = args.game_id or binding.get('gameId')
    if not game:
        raise ValueError('gameBindingUnavailable')
    logs = {'from': args.from_time, 'to': args.to_time, 'operation': args.operation,
            'ctxId': args.ctx_id, 'cursor': args.cursor}
    request = {'gameId': game, 'roleId': args.role_id, 'kind': args.kind}
    if args.source == 'runtime-errors':
        request = {'gameId': game, 'kind': 'logs', 'logsParams': {'limit': args.limit if args.limit is not None else 50}}
        if args.role_id is not None: request['logsParams']['roleId'] = args.role_id
        if args.bundle_version is not None: request['logsParams']['bundleVersion'] = args.bundle_version
    elif args.kind == 'data':
        if any(v is not None for v in logs.values()):
            raise ValueError('invalid data parameters')
        request['dataParams'] = {'keys': args.key or []}
    else:
        if not args.from_time or not args.to_time or len(args.key or []) > 1:
            raise ValueError('logs requires from/to and at most one key filter')
        if args.key: logs['key'] = args.key[0]
        request['logsParams'] = {k: v for k, v in logs.items() if v is not None}
        if args.source == 'player-data':
            request['logsParams']['limit'] = args.limit if args.limit is not None else 50
    parent = pathlib.Path(token_path).read_text(encoding='utf-8').strip()

    def post(path, body, credential):
        req = urllib.request.Request(base.rstrip('/')+path, data=json.dumps(body).encode('utf-8'),
            headers={'Content-Type':'application/json','Authorization':'Bearer '+credential}, method='POST')
        try:
            with urllib.request.build_opener(DiagnosticNoRedirect).open(req) as res:
                raw = res.read()
        except urllib.error.HTTPError as err:
            raw = err.read()
            try: response = json.loads(raw)
            except (ValueError, UnicodeError): raise ValueError('dependencyUnavailable') from None
            if not isinstance(response, dict) or type(response.get('code')) is not int or response['code'] == 0 or 'token' in response:
                raise ValueError('invalid error envelope')
            return response
        response = json.loads(raw)
        if not isinstance(response, dict): raise ValueError('invalid response envelope')
        return response

    for attempt in range(2):
        grant = post('/api/v1/agent/diagnostics/grant', {'gameId':game}, parent)
        if not grant.get('token'):
            if type(grant.get('code')) is not int or grant['code'] == 0:
                raise ValueError('invalid grant response')
            print(json.dumps(grant, ensure_ascii=False));return 1
        if not isinstance(grant['token'], str): raise ValueError('invalid grant response')
        response = post('/api/v1/agent/diagnostics/'+args.source+'/query', request, grant['token'])
        if response.get('message') == 'diagnosticGrantExpired' and attempt == 0: continue
        if type(response.get('code')) is not int or 'token' in response:
            raise ValueError('invalid response envelope')
        print(json.dumps(response, ensure_ascii=False,separators=(',',':')))
        return 0 if response['code'] == 0 else 1
    return 1

try:
    sys.exit(main(sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]))
except (OSError, ValueError, urllib.error.URLError) as exc:
    # Do not echo exceptions from HTTP (URLs, dependency bodies or credentials).
    print('BUILDA_DIAGNOSTICS_FAILED: check binding, authorization and API availability', file=sys.stderr)
    sys.exit(1)

