# detect_engine_value silently detects the engine (lowercase, consistent with backend/protocol conventions):
# godot first (project.godot present => godot); unity = ProjectSettings/ProjectVersion.txt or
# Assets/+Packages/manifest.json; HTML5 = index.html or package.json at the root
# (pixi/phaser/vite and similar project shapes).
detect_engine_value() {
  local root="${1:-.}"
  if [ -f "$root/project.godot" ]; then
    echo "godot"
  elif [ -f "$root/ProjectSettings/ProjectVersion.txt" ] || { [ -d "$root/Assets" ] && [ -f "$root/Packages/manifest.json" ]; }; then
    echo "unity"
  elif [ -f "$root/index.html" ] || [ -f "$root/package.json" ]; then
    echo "h5"
  else
    echo "unknown"
  fi
}

# Print the on-demand topics that apply to this project's engine beyond the base Skill core; the Agent reads only the matching ones (see the task routing table in SKILL.md).
print_skill_topics() {
  local engine="$1" base="$BUILDA_AGENT_BASE/agent/releases/$VERSION" topic sdk_version
  case "$engine" in
    godot) topic=godot ;;
    h5) topic=html5 ;;
    unity) topic=unity ;;
    *) topic="" ;;
  esac
  echo "skill-topic-publish=$base/md_agent_publish.md"
  echo "skill-topic-diagnostics=$base/md_agent_diagnostics.md"
  [ -n "$topic" ] && echo "skill-topic-export=$base/md_agent_$topic.md"
  sdk_version=""
  [ -f "$SDK_VERSION_FILE" ] && sdk_version="$(tr -d '[:space:]' < "$SDK_VERSION_FILE")"
  if [ -n "$topic" ] && [ -n "$sdk_version" ] && [ -f "$PROJECT_STATE_DIR/sdk-guidance/$sdk_version/md_sdk_$topic.md" ]; then
    echo "sdk-topic-engine=$PROJECT_STATE_DIR/sdk-guidance/$sdk_version/md_sdk_$topic.md"
  fi
}

engine_detect() {
  local root="${1:-.}"
  [ -d "$root" ] || { echo "engine-detect=failed"; echo "directory not found: $root" >&2; exit 1; }
  local engine
  engine="$(detect_engine_value "$root")"
  echo "engine=$engine"
  case "$engine" in
    godot|h5|unity)
      echo "engine-upload-support=available"
      return 0
      ;;
    *)
      echo "engine-upload-support=unknown"
      echo "Project engine could not be detected. Do not upload until the user points you at a Godot, HTML5 or Unity project root." >&2
      return 1
      ;;
  esac
}

# manifest_engine is the single source of the engine: the manifest engine field wins; if missing, detect from the directory;
# invalid values fall back to godot (consistent with the backend's "empty = godot" normalization).
manifest_engine() {
  local file="${1:-$MANIFEST}" v=""
  [ -f "$file" ] && v="$(manifest_string_field "$file" engine)"
  if [ -z "$v" ]; then
    v="$(detect_engine_value .)"
  fi
  case "$v" in
    godot|h5|unity) ;;
    *) v="godot" ;;
  esac
  printf '%s' "$v"
}

godot_web_template_check() {
  local godot_cmd="${1:-godot}"
  if ! command -v "$godot_cmd" >/dev/null 2>&1; then
    echo "godot-web-template=missing-godot-command"
    echo "Godot command not found: $godot_cmd" >&2
    echo "Install Godot, or rerun with the actual command: builda godot web-template-check godot4" >&2
    exit 1
  fi

  local version template_version template_dir
  version="$("$godot_cmd" --version 2>/dev/null | awk '{print $1}' | head -1)"
  if [ -z "$version" ]; then
    echo "godot-web-template=unknown-version"
    echo "Could not read Godot version from: $godot_cmd --version" >&2
    exit 1
  fi

  template_version="$(printf '%s' "$version" | sed 's/\.official\..*$//')"
  template_dir="$HOME/.local/share/godot/export_templates/$template_version"
  if [ -f "$template_dir/web_release.zip" ] || [ -f "$template_dir/web_nothreads_release.zip" ]; then
    echo "godot-web-template=ok"
    echo "godot-command=$godot_cmd"
    echo "godot-version=$version"
    echo "godot-template-version=$template_version"
    echo "godot-template-dir=$template_dir"
    return 0
  fi

  echo "godot-web-template=missing"
  echo "godot-command=$godot_cmd"
  echo "godot-version=$version"
  echo "godot-template-version=$template_version"
  echo "godot-template-dir=$template_dir"
  echo "Godot is installed, but Web export templates are missing for this HOME." >&2
  echo "Install matching Web export templates for Godot $version, then retry the export." >&2
  echo "If templates exist under another HOME on this machine, copy that version directory to: $template_dir" >&2
  echo "Do not zip/upload a failed or partial export; rerun bundle-check after a successful export." >&2
  exit 1
}

# Game_* commands are mandarin cmd-over-HTTP routes mounted at /game/*.
# Agent REST helpers such as upload/auth live under /api/v1/*.
cmd_url() { printf '%s/%s' "$BUILDA_BASE" "$1"; }

http_request() {
  local label="$1"
  shift
  local body_file status curl_code
  body_file="$(mktemp)"
  status="$(curl -sS -o "$body_file" -w "%{http_code}" "$@")" || {
    curl_code=$?
    echo "$label failed: curl exit $curl_code" >&2
    if [ -s "$body_file" ]; then
      echo "$label response body:" >&2
      cat "$body_file" >&2
      echo >&2
    fi
    rm -f "$body_file"
    return "$curl_code"
  }
  case "$status" in
    2??)
      cat "$body_file"
      rm -f "$body_file"
      return 0
      ;;
    *)
      echo "$label failed: HTTP $status" >&2
      echo "$label response body:" >&2
      cat "$body_file" >&2
      echo >&2
      if [ "$status" = "401" ] || [ "$status" = "403" ] || grep -q '"code"[[:space:]]*:[[:space:]]*10006' "$body_file"; then
        if [ "$label" = "Studio auth exchange" ]; then
          echo "studio-authorization-expired=1" >&2
        else
          echo "auth-required=1" >&2
          echo "Agent grant is missing or expired. Run: builda auth" >&2
          auth_recovery_hint >&2
        fi
      fi
      rm -f "$body_file"
      return 1
      ;;
  esac
}

authenticated_http_response() {
  local label="$1"
  shift
  local body_file curl_code attempt=0
  body_file="$(mktemp)"
  AUTH_HTTP_STATUS=""
  AUTH_HTTP_BODY=""
  while [ "$attempt" -lt 2 ]; do
    AUTH_HTTP_STATUS="$(curl -sS -o "$body_file" -w "%{http_code}" "$@" -H "Authorization: Bearer $(token)")" || {
      curl_code=$?
      echo "$label failed: curl exit $curl_code" >&2
      rm -f "$body_file"
      return "$curl_code"
    }
    AUTH_HTTP_BODY="$(cat "$body_file")"
    if [ "$AUTH_HTTP_STATUS" = "401" ] && [ "$attempt" -eq 0 ] && [ -f "$REFRESH_FILE" ]; then
      if refresh_grant >&2; then
        attempt=$((attempt + 1))
        continue
      fi
    fi
    if [ "$AUTH_HTTP_STATUS" = "401" ]; then
      echo "BUILDA_AUTH_REJECTED: authorization was rejected after one refresh" >&2
      rm -f "$body_file"
      return 1
    fi
    rm -f "$body_file"
    return 0
  done
  rm -f "$body_file"
  echo "BUILDA_AUTH_REJECTED: authorization was rejected after one refresh" >&2
  return 1
}

authenticated_http_request() {
  local label="$1"
  shift
  authenticated_http_response "$label" "$@" || return $?
  case "$AUTH_HTTP_STATUS" in
    2??)
      printf '%s' "$AUTH_HTTP_BODY"
      ;;
    *)
      echo "$label failed: HTTP $AUTH_HTTP_STATUS" >&2
      printf '%s\n' "$AUTH_HTTP_BODY" >&2
      if [ "$AUTH_HTTP_STATUS" = "403" ] || grep -q '"code"[[:space:]]*:[[:space:]]*10006' <<EOF
$AUTH_HTTP_BODY
EOF
      then
        echo "auth-required=1" >&2
        echo "Agent grant is missing or expired. Run: builda auth" >&2
        auth_recovery_hint >&2
      fi
      return 1
      ;;
  esac
}

json_field() {
  local name="$1"
  if command -v jq >/dev/null 2>&1; then
    jq -r ".$name // empty"
  else
    sed -n "s/.*\"$name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -1
  fi
}

json_number() {
  local name="$1"
  if command -v jq >/dev/null 2>&1; then
    jq -r ".$name // 0"
  else
    sed -n "s/.*\"$name\"[[:space:]]*:[[:space:]]*\\([0-9]*\\).*/\\1/p" | head -1
  fi
}

