import hashlib, json, os, re, sys, time

def load(path):
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)

def dump(obj):
    return json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":"))

def md5_of(path):
    h = hashlib.md5()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()

def safe_task(task_id):
    return re.sub(r"[^A-Za-z0-9_.-]", "_", task_id)

def short_id(task_id):
    s = re.sub(r"[^A-Za-z0-9]", "", task_id)
    return (s[-8:] or "task").lower()

INT_PARAMS = {"count", "targetFaces"}
# Types this CLI version can generate; keep in sync with gen_command dispatch. Types the platform lists but not in this set are marked cli-support=no.
CLI_GEN_TYPES = {"audio", "music", "image", "model3d"}

def cmd_request(argv):
    # argv: genType model prompt nonce extra refIds...; extra is normalized "k=v;k=v" (sorted by key), empty for audio.
    gen_type, model, prompt, nonce, extra, refs = argv[0], argv[1], argv[2], argv[3], argv[4], argv[5:]
    params = {"prompt": prompt}
    for kv in [x for x in extra.split(";") if x]:
        k, _, v = kv.partition("=")
        # Keep non-integers as-is; the pre-submit limits check reports a param error (must not crash here).
        if k in ("lyrics64", "title64"):
            import base64
            params[k[:-2]] = base64.b64decode(v).decode("utf-8")
        elif k in ("duration", "promptInfluence"):
            params[k] = float(v)
        elif k in ("loop", "instrumental"):
            params[k] = v == "true"
        else:
            params[k] = int(v) if k in INT_PARAMS and re.fullmatch(r"-?\d+", v) else v
    if refs:
        params["referenceIds"] = refs
    body = {"genType": gen_type, gen_type: params}
    if model:
        body["model"] = model
    # Derivation matches builda.ps1 byte for byte: NUL-separated plain strings, independent of any JSON serialization details.
    fields = ["builda-gen-v1", gen_type, model, prompt, ",".join(refs)]
    if extra:
        # Append only when there are type-specific params: audio derivation stays byte-identical to 0.4.74, so reruns after upgrade still resume the original task.
        fields.append(extra)
    canonical = "\0".join(fields)
    base = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
    request_id = hashlib.sha256(("builda-gen-req-v1\0" + base + "\0" + nonce).encode("utf-8")).hexdigest()
    body["requestId"] = request_id
    print(base)
    print(request_id)
    print(dump(body))

def cmd_get(argv):
    # argv: jsonFile dotted.path — prints scalar or JSON
    value = load(argv[0])
    for part in argv[1].split("."):
        if isinstance(value, dict):
            value = value.get(part)
        elif isinstance(value, list) and part.isdigit() and int(part) < len(value):
            value = value[int(part)]
        else:
            value = None
    if value is None:
        return
    if isinstance(value, bool):
        print("true" if value else "false")
    elif isinstance(value, (dict, list)):
        print(dump(value))
    else:
        print(value)

def cmd_error(argv):
    try:
        body = load(argv[0])
    except Exception:
        body = {}
    if not isinstance(body, dict):
        body = {}
    print(body.get("code", ""))
    print("true" if body.get("retriable") else "false")
    print(",".join(body.get("runningTaskIds") or []))
    msg = str(body.get("msg") or body.get("message") or "").replace("\n", " ")
    # The platform embeds its own reqId in message: split it out to avoid confusion with Builda's request-id.
    platform_req = ""
    m = re.search(r"\s*reqId=(\S+)", msg)
    if m:
        platform_req, msg = m.group(1), (msg[:m.start()] + msg[m.end():]).strip()
    print(msg[:300])
    print(platform_req)

def cmd_plan(argv):
    # argv: taskJson outArg taskId genType → TSV: url md5 size dest
    task, out, task_id, gen_type = load(argv[0]), argv[1], argv[2], argv[3]
    outputs = [o for o in (task.get("outputs") or []) if o.get("url")]
    if not outputs:
        raise SystemExit("task finished without output files")
    if not out:
        out = os.path.join("builda-gen", gen_type) + os.sep
    as_dir = out.endswith(("/", os.sep)) or os.path.isdir(out)
    out = os.path.normpath(out) + (os.sep if as_dir else "")
    base = None
    if not as_dir:
        base, ext = os.path.splitext(out)
    first_kind = re.sub(r"[^a-z0-9]", "", (outputs[0].get("kind") or "").lower())
    for i, o in enumerate(outputs):
        fmt = (o.get("format") or os.path.splitext(o["url"].split("?")[0])[1].lstrip(".") or "bin").lower()
        kind = re.sub(r"[^a-z0-9]", "", (o.get("kind") or "").lower())
        # Same-kind outputs (multiple images) are numbered, different-kind outputs (3D preview) use kind: hero.png/hero-2.png, chest.glb/chest-preview.png
        suffix = "" if i == 0 else "-" + (kind if kind and kind != first_kind else str(i + 1))
        if as_dir:
            dest = os.path.join(out, f"{gen_type}-{short_id(task_id)}{suffix}.{fmt}")
        else:
            dest = f"{base}{suffix}.{fmt}"
        dims = f"{o['width']}x{o['height']}" if o.get("width") and o.get("height") else ""
        print("\t".join([o["url"], (o.get("md5") or "").lower(), str(o.get("size") or 0), dest, dims]))

def cmd_check_out(argv):
    # Outputs must stay inside the project: judged by real path (symlinks resolved); toolchain/Git dirs compared case-insensitively (macOS/Windows filesystems).
    out = argv[0]
    if os.path.isabs(out) or out.startswith("~"):
        raise SystemExit(1)
    root = os.path.realpath(os.getcwd())
    real = os.path.realpath(os.path.join(root, out))
    rel = os.path.relpath(real, root)
    first = rel.replace("\\", "/").split("/")[0].lower()
    if rel == os.curdir or first in ("..", ".builda-agent", ".git"):
        raise SystemExit(1)

def cmd_out_free(argv):
    # File mode: target (including extension rewritten per format) already exists -> exit 1; directory mode names include the task id, so no conflict.
    # On conflict, print the actually conflicting file and exit 1.
    out, gen_type = argv[0], argv[1]
    count = int(argv[2]) if (argv[2] or "").isdigit() else 1
    if out.endswith(("/", os.sep)) or os.path.isdir(out):
        return
    base = os.path.splitext(out)[0]
    fmt = {"audio": ".mp3", "image": ".png", "model3d": ".glb"}.get(gen_type, "")
    candidates = [out] + ([base + fmt] if fmt else [])
    if gen_type == "image":
        candidates += [f"{base}-{i}.png" for i in range(2, count + 1)]
    if gen_type in ("audio", "music"):
        for ext in ("mp3", "m4a"):
            candidates += [base + "." + ext] + [f"{base}-{i}.{ext}" for i in range(2, count + 1)]
    if gen_type == "music":
        # FlowMusic may return bonus takes beyond the requested count.
        directory = os.path.dirname(base) or "."
        if os.path.isdir(directory):
            pattern = re.compile(re.escape(os.path.basename(base)) + r"-\d+\.(mp3|m4a)$")
            candidates += [os.path.join(directory, name) for name in os.listdir(directory) if pattern.fullmatch(name)]
    hit = next((c for c in candidates if os.path.exists(c)), None)
    if hit:
        print(hit)
        raise SystemExit(1)

def cmd_check_ref(argv):
    # Judge by file content (header), not extension: a fake png is caught locally without uploading.
    path = argv[0]
    if os.path.getsize(path) > 10 << 20 or not sniff_ext(path):
        raise SystemExit(1)

IMAGE_EXTS = {"png", "jpg", "jpeg", "webp"}

def sniff_ext(path):
    with open(path, "rb") as fh:
        head = fh.read(16)
    if head.startswith(b"\x89PNG\r\n\x1a\n"):
        return "png"
    if head.startswith(b"\xff\xd8\xff"):
        return "jpg"
    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        return "webp"
    return ""

def cmd_sniff(argv):
    # argv: file plannedExt -> print the extension to use: only corrects platform metadata between image formats by file header (the platform once labeled PNG as jpg).
    planned = argv[1].lower().lstrip(".")
    real = sniff_ext(argv[0])
    print(real if planned in IMAGE_EXTS and real and real != planned and not (planned == "jpeg" and real == "jpg") else planned)

def cmd_validate(argv):
    # argv: modelsJson genType model extra refCount promptLen outArg
    # Validate before submit using limits from platform gen models; when out of range print "param<TAB>allowed<TAB>message" and exit 1.
    data, gen_type, want, extra = load(argv[0]), argv[1], argv[2], argv[3]
    ref_count, prompt_len, out = int(argv[4]), int(argv[5]), argv[6]
    params = dict(kv.partition("=")[::2] for kv in extra.split(";") if kv)
    def fail(param, allowed, message):
        print(f"{param}\t{allowed}\t{message}")
        raise SystemExit(1)
    models = next((g.get("models") or [] for g in data.get("groups") or [] if g.get("genType") == gen_type), [])
    if not models:
        raise SystemExit(3)  # this type is not enabled for this account
    if want:
        pick = next((m for m in models if m.get("model") == want), None)
        if pick is None:
            # Wrong model name or a model of another type: report as a param error so the agent doesn't think the platform hasn't enabled it.
            fail("--model", ",".join(m.get("model", "") for m in models), f"model {want} is not available for {gen_type}")
    else:
        pick = next((m for m in models if m.get("isDefault")), models[0])
    lim = pick.get("limits") or {}
    def num_range(value, lo_key, hi_key, param):
        lo, hi = lim.get(lo_key), lim.get(hi_key)
        allowed = f"{lo if lo is not None else ''}..{hi if hi is not None else ''}" if (lo is not None or hi is not None) else "a whole number"
        if not re.fullmatch(r"-?\d+", str(value)):
            fail(param, allowed, f"{param} {value} is not a whole number")
        v = int(value)
        if (lo is not None and v < lo) or (hi is not None and v > hi) or v <= 0:
            fail(param, allowed, f"{param} {v} is out of range")
    if lim.get("promptMaxLen") and prompt_len > lim["promptMaxLen"]:
        fail("--prompt", f"<= {lim['promptMaxLen']} chars", f"prompt is {prompt_len} chars")
    if lim.get("referenceMax") is not None and ref_count > lim["referenceMax"]:
        fail("--ref", f"<= {lim['referenceMax']} images", f"{ref_count} reference images given")
    import base64, math
    if gen_type in ("music", "audio") and ref_count > (lim.get("referenceMax") or 0):
        fail("--ref", str(lim.get("referenceMax") or 0), "model does not support these references")
    for key in ("lyrics", "title"):
        if key+"64" in params:
            try: text = base64.b64decode(params[key+"64"]).decode("utf-8")
            except (ValueError, UnicodeError): fail("--"+key, "UTF-8 text", "invalid text")
            if lim.get(key+"MaxLen") and len(text) > lim[key+"MaxLen"]:
                fail("--"+key, str(lim[key+"MaxLen"]), "text is too long")
            if key == "lyrics" and text.strip() and params.get("instrumental") == "true":
                fail("--lyrics", "empty with --instrumental", "instrumental music cannot have lyrics")
    for key, flag, lo, hi in (("duration", "--duration", lim.get("targetDurationMinSec"), lim.get("targetDurationMaxSec")), ("promptInfluence", "--prompt-influence", 0, 1)):
        if key not in params: continue
        try: value = float(params[key])
        except ValueError: fail(flag, "finite number", "invalid number")
        if not math.isfinite(value): fail(flag, "finite number", "invalid number")
        if key == "duration" and not hi: fail(flag, "model with target duration support", "unsupported parameter")
        if key == "duration" and value == 0: continue
        if value < (lo or 0) or (hi is not None and value > hi): fail(flag, f"{lo}..{hi}", "out of range")
        if key == "duration" and pick.get("model") == "lyria-3.5" and not value.is_integer(): fail(flag, "whole seconds", "FlowMusic requires integer duration")
    if "loop" in params and not lim.get("supportsLoop"): fail("--loop", "supported model", "unsupported parameter")
    if "promptInfluence" in params and not lim.get("supportsPromptInfluence"): fail("--prompt-influence", "supported model", "unsupported parameter")
    if gen_type == "audio" and "count" in params and not lim.get("countMax"):
        fail("--count", "model with count support", "unsupported parameter")
    if "count" in params:
        num_range(params["count"], "countMin", "countMax", "--count")
    if "aspectRatio" in params and lim.get("aspectRatios") and params["aspectRatio"] not in lim["aspectRatios"]:
        fail("--aspect-ratio", ",".join(lim["aspectRatios"]), f"aspect ratio {params['aspectRatio']} is not supported")
    if "backgroundMode" in params and lim.get("backgroundModes") and params["backgroundMode"] not in lim["backgroundModes"]:
        fail("--background", ",".join(lim["backgroundModes"]), f"background {params['backgroundMode']} is not supported")
    if "targetFaces" in params:
        num_range(params["targetFaces"], "targetFacesMin", "targetFacesMax", "--faces")
    if params.get("backgroundMode") == "transparent" and os.path.splitext(out)[1].lower() in (".jpg", ".jpeg"):
        fail("-o", ".png, .webp or a directory", "jpg cannot store a transparent background")

def cmd_task_time(argv):
