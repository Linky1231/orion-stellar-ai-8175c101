sdk_install_unity() {
  # Unity projects: C# wrapper/jslib go to Assets/Builda/, the Builda WebGL template to Assets/WebGLTemplates/
  # (template location required by Unity), web core mock to $PROJECT_STATE_DIR/sdk/web/ (same as h5).
  # All three locations are SDK-owned and overwritten wholesale on upgrade (no project-owned preservation like Godot mic).
  command -v unzip >/dev/null 2>&1 || { echo "Need unzip to install the Unity SDK." >&2; exit 1; }
  sdk_prepare_verified_archive "unity/latest.json" "builda-sdk-unity.zip" || exit 1
  local tmpdir="$SDK_TRANSACTION_ROOT/stage"
  mkdir -p "$tmpdir"
  if ! unzip -q -o "$SDK_ARCHIVE" -d "$tmpdir"; then rm -rf "$SDK_TRANSACTION_ROOT"; echo "Unity SDK zip invalid." >&2; exit 1; fi
  [ -d "$tmpdir/Assets/Builda" ] && [ -d "$tmpdir/Assets/WebGLTemplates/Builda" ] && [ -d "$tmpdir/.builda-agent/sdk/web" ] \
    || { echo "Unity SDK zip layout invalid." >&2; rm -rf "$SDK_TRANSACTION_ROOT"; exit 1; }
  local -a install_pairs=(
    "$tmpdir/guidance" "$PROJECT_STATE_DIR/sdk-guidance/$SDK_SELECTED_VERSION"
    "$tmpdir/Assets/Builda" "Assets/Builda"
    "$tmpdir/Assets/WebGLTemplates/Builda" "Assets/WebGLTemplates/Builda"
    "$tmpdir/.builda-agent/sdk/web" "$PROJECT_STATE_DIR/sdk/web"
  )
  # The BuildaMic analysis Worker is project-owned (L2 template; CPs may modify the algorithm): upgrades do not overwrite an existing dir;
  # restore defaults = delete Assets/StreamingAssets/builda-mic and rerun sdk install
  if [ -d "$tmpdir/Assets/StreamingAssets/builda-mic" ]; then
    if [ -d Assets/StreamingAssets/builda-mic ]; then
      echo "sdk-mic=preserved (Assets/StreamingAssets/builda-mic is project-owned; delete it and rerun sdk install to reset to defaults)"
    else
      install_pairs+=("$tmpdir/Assets/StreamingAssets/builda-mic" "Assets/StreamingAssets/builda-mic")
      echo "sdk-mic=Assets/StreamingAssets/builda-mic"
    fi
  fi
  sdk_install_directory_set "$SDK_TRANSACTION_ROOT" "${install_pairs[@]}" || exit 1
  sdk_finish_install || exit 1
  echo "sdk-version=$SDK_SELECTED_VERSION"
  echo "sdk-installed=Assets/Builda"
  echo "sdk-engine=unity"
  echo "sdk-next-1=Player Settings > Resolution and Presentation > WebGL Template: choose Builda (the template is installed at Assets/WebGLTemplates/Builda/ and already references builda-sdk.js in head)"
  echo "sdk-next-2=Player Settings > Publishing Settings: set Compression Format to Brotli and check Decompression Fallback (recommended), or choose Disabled; builds with compression on but Fallback unchecked are rejected by upload validation"
  echo "sdk-next-3=local debugging: builda dev --web <WebGL build dir or zip> (the dev server automatically falls back to serving the mock SDK and test shell from $PROJECT_STATE_DIR/sdk/web)"
  sdk_online_bootstrap "$SDK_SELECTED_VERSION" || true
  if ! sdk_check; then
    echo "sdk-install=ok"
    echo "sdk-next=fix sdk check errors, then rerun: builda sdk check" >&2
    return 0
  fi
