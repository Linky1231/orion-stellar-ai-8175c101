                  f"price={p.get('unitCost','')}/{p.get('unitCount') or 1}{p.get('mode','')} max-cost={m.get('estimatedMax') or p.get('maxCost','')} "
                  f"name={json.dumps(m.get('displayName',''), ensure_ascii=False)} limits={limits}")

def cmd_usage(argv):
    data = load(argv[0])
    items = data.get("list") or []
    if not items:
        print("transactions=0")
    for t in items:
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime((t.get("createAt") or 0) / (1000 if (t.get("createAt") or 0) > 1e11 else 1)))
        # source tells whether this entry was initiated by Builda (gen API caller=platform); consumption by the same account in the App is marked app/other.
        source = "builda" if t.get("caller") == "platform" else (t.get("caller") or "app/other")
        print(f"time={when} change={t.get('change','')} balance-after={t.get('balanceAfter','')} source={source} "
              f"type={t.get('genType','') or '-'} task={t.get('taskId','') or '-'} "
              f"reason={json.dumps(t.get('reason',''), ensure_ascii=False)}")
    print("more=" + ("no" if data.get("noMore", True) else "yes"))

def params_obj(v):
    # "k=v;k=v" -> object, numeric values converted to integers
    out = {}
    for kv in (v or "").split(";"):
        if kv:
            k, _, x = kv.partition("=")
            if k in ("lyrics64", "title64"):
                import base64
                out[k[:-2]] = base64.b64decode(x).decode("utf-8")
            elif k in ("duration", "promptInfluence"): out[k] = float(x)
            elif k in ("loop", "instrumental"): out[k] = x == "true"
            else: out[k] = int(x) if re.fullmatch(r"-?\d+", x) else x
    return out

def cmd_to_json(argv):
    # key=value lines → one JSON object; repeated keys become arrays; ints stay ints
    obj = {}
    with open(argv[0], "r", encoding="utf-8") as fh:
        for line in fh:
            line = line.rstrip("\n")
            if "=" not in line:
                continue
            k, _, v = line.partition("=")
            key = re.sub(r"-([a-z])", lambda m: m.group(1).upper(), k)
            val = int(v) if re.fullmatch(r"-?\d+", v) else v
            # Make JSON types directly usable: yes/no -> boolean, running -> array, params -> object.
            if key in ("reused", "charged", "newGeneration", "newIgnored", "energySettled") and v in ("yes", "no"):
                val = v == "yes"
            elif key == "running":
                val = [x for x in v.split(",") if x]
            elif key == "params":
                val = params_obj(v)
            if key == "hint" and "hint" in obj:
                obj["hint"] = obj["hint"] + "; " + v  # hint is always a single string
                continue
            if key in ("file", "md5", "dimensions"):
                obj.setdefault(key + "s" if key != "dimensions" else key, []).append(val)
            elif key in obj:
                obj[key] = obj[key] if isinstance(obj[key], list) else [obj[key]]
                obj[key].append(val)
            else:
                obj[key] = val
    print(dump(obj))

COMMANDS = {"request": cmd_request, "get": cmd_get, "error": cmd_error, "plan": cmd_plan, "md5": cmd_md5,
            "ledger-task": cmd_ledger_task, "check-out": cmd_check_out, "sniff": cmd_sniff, "validate": cmd_validate, "ledger-get": cmd_ledger_get, "ledger-time": cmd_ledger_time, "task-time": cmd_task_time, "check-ref": cmd_check_ref, "out-free": cmd_out_free, "ledger-out": cmd_ledger_out, "request-state": cmd_request_state,
            "request-save": cmd_request_save, "request-done-for-task": cmd_request_done_for_task,
            "list": cmd_list, "estimate": cmd_estimate, "models": cmd_models, "usage": cmd_usage,
            "to-json": cmd_to_json}
COMMANDS[sys.argv[1]](sys.argv[2:])
PY

gen_py() { python3 -c "$GEN_PY" "$@"; }

GEN_CLI="./$ROOT/builda"
# Top-up path relayed verbatim to the user when Credits are insufficient (user-facing text; the agent must not rewrite it).
GEN_TOPUP_HINT="In the Builda App, create an AI game, then tap the top-right button 3 times in a row to open the Credits page and top up"

# gen_need_value: a missing value or a value that looks like an option (-o --json, --prompt --dry-run) exits as a param error; never submit and charge with misaligned args.
# Use --opt=value when a value really starts with -.
# gen_retry_hint gives retry advice per stage: with no task yet, state clearly "no task created, not charged"; only with a task, suggest resuming it.
gen_retry_hint() {
  if [ -z "$GEN_TASK_ID" ]; then
    printf 'no task was created and nothing was charged; wait about a minute, then run the same command again'
  else
    printf 'the task is still on the platform (no double charge); wait about a minute, then run next'
  fi
}

# gen_retry_next gives a runnable resume-wait command when a task exists; with no task there is no command to give (just rerun as-is).
gen_retry_next() {
  [ -z "$GEN_TASK_ID" ] || gen_next_wait
}

# gen_param_error: unified format for local param errors: param / allowed / charged=no, consistent with platform limits validation.
# Usage: gen_param_error <param> <allowed> [error] [hint]
gen_param_error() {
  gen_emit param "$1"
  gen_emit allowed "$2"
  local tail="and run again"
  [ "${GEN_IS_GENERATE:-0}" != "1" ] || tail="and run again; nothing was submitted or charged"
  gen_die 2 "${3:-invalid-params}" "${4:-fix $1 (allowed: $2) $tail}"
}

gen_need_value() {
  if [ "$#" -lt 2 ]; then
    gen_param_error "$1" "a value" missing-value "$1 needs a value"
  elif [[ "$2" == -* ]]; then
    gen_param_error "$1" "a value (for a value starting with -, use $1=<value>)" value-looks-like-option "the value of $1 looks like another option"
  fi
}

# gen_quote makes next= paste-and-run: safe chars output as-is, others double-quoted (keeps UTF-8, no bash-specific escapes).
gen_quote() {
  if [[ "$1" =~ ^[A-Za-z0-9._/:@+-]+$ ]]; then
    printf '%s' "$1"
  else
    printf '"%s"' "${1//\"/\\\"}"
  fi
}

# gen_emit writes one result line: printed directly in human mode; in --json mode accumulated and merged into one object by gen_finish.
gen_emit() {
  printf '%s=%s\n' "$1" "$2" >> "$GEN_RESULT_FILE"
  [ "$GEN_JSON" = "1" ] || printf '%s=%s\n' "$1" "$2"
}

gen_emit_once() {
  grep -q "^$1=" "$GEN_RESULT_FILE" 2>/dev/null || gen_emit "$1" "$2"
}

gen_finish() {
  local code="${1:-0}"
  if [ "$GEN_JSON" = "1" ] && [ -n "$GEN_RESULT_FILE" ]; then
    gen_py to-json "$GEN_RESULT_FILE"
  fi
  [ -n "$GEN_RESULT_FILE" ] && rm -f "$GEN_RESULT_FILE"
  exit "$code"
}

gen_progress() { printf 'gen| %s\n' "$*" >&2; }

# Usage: gen_die <exit> <error> [hint] [next]. hint= is an explanation for humans/agents; next= holds only a runnable command (omitted if none).
# When a gen command fails before any task exists, always include charged=no: nothing submitted, nothing charged.
gen_die() {
  local code="$1" error="$2" hint="${3:-}" next="${4:-}"
  if [ "${GEN_IS_GENERATE:-0}" = "1" ] && [ -z "$GEN_TASK_ID" ]; then gen_emit_once charged no; fi
  gen_emit error "$error"
  [ -z "$hint" ] || gen_emit hint "$hint"
  [ -z "$next" ] || gen_emit next "$next"
  gen_finish "$code"
}

gen_need_auth() {
  if grant_needs_refresh; then
    refresh_grant >/dev/null 2>&1 || true
  fi
  if [ ! -f "$TOKEN_FILE" ] && [ -f "$REFRESH_FILE" ]; then
    refresh_grant >/dev/null 2>&1 || true
  fi
  [ -f "$TOKEN_FILE" ] || gen_die 3 auth-required "authorize first (the user approves in the browser), then rerun this command" "$GEN_CLI auth"
}

# The gen_* getters below write globals instead of echoing: gen_die must run in the main shell to actually exit.
gen_parse_duration() {
  local raw="$1" n="" mult=1
  case "$raw" in
    *h) n="${raw%h}"; mult=3600 ;;
    *m) n="${raw%m}"; mult=60 ;;
    *s) n="${raw%s}" ;;
    *) n="$raw" ;;
  esac
  [[ "$n" =~ ^[0-9]+$ ]] || gen_param_error --wait "90, 90s, 5m, 1h" invalid-duration
  GEN_DURATION=$((n * mult))
}

gen_next_wait() {
  local cmd="$GEN_CLI gen wait $GEN_TASK_ID"
  [ -z "$GEN_OUT_ARG" ] || cmd="$cmd -o $(gen_quote "$GEN_OUT_ARG")"
  printf '%s' "$cmd"
}

# gen_api METHOD PATH [curl args...]: on success writes the response body to the $GEN_BODY file; on failure exits per the contract.
gen_api() {
  local method="$1" path="$2" rc
  shift 2
  GEN_BODY="$(mktemp)"
  local hdr
  hdr="$(mktemp)"
  rc=0
  authenticated_http_response "gen $path" -X "$method" "$BUILDA_BASE$path" -D "$hdr" "$@" 2>/dev/null || rc=$?
  # Every server response carries X-Request-Id: print it to the user/agent on error so feedback can locate backend logs directly.
  GEN_REQUEST_ID="$(tr -d '\r' < "$hdr" | sed -n 's/^[Xx]-[Rr]equest-[Ii]d:[[:space:]]*//p' | tail -n 1)"
  rm -f "$hdr"
  if [ "${AUTH_HTTP_STATUS:-}" = "401" ]; then
    [ -z "$GEN_REQUEST_ID" ] || gen_emit request-id "$GEN_REQUEST_ID"
    gen_die 3 auth-required "authorize first (the user approves in the browser), then rerun this command" "$GEN_CLI auth"
  fi
  if [ "$rc" -ne 0 ]; then
    gen_die 9 network-error "check the network; $(gen_retry_hint)" "$(gen_retry_next)"
  fi
  printf '%s' "$AUTH_HTTP_BODY" > "$GEN_BODY"
  case "$AUTH_HTTP_STATUS" in
    2??) return 0 ;;
  esac
  gen_fail_body
}

gen_fail_body() {
  local code retriable running msg platform_req
  { read -r code; read -r retriable; read -r running; read -r msg; read -r platform_req; } < <(gen_py error "$GEN_BODY")
  [ -z "$msg" ] || gen_emit message "$msg"
  [ -z "$code" ] || gen_emit code "$code"
  # request-id is the number to give when reporting issues; platform-request-id is the platform's internal number, for reconciliation only.
  [ -z "${GEN_REQUEST_ID:-}" ] || gen_emit request-id "$GEN_REQUEST_ID"
  [ -z "$platform_req" ] || gen_emit platform-request-id "$platform_req"
  case "$code" in
    140006)
      gen_emit energy-topup "$GEN_TOPUP_HINT"
      gen_die 4 insufficient-energy "tell the user their Builda Credits are not enough and relay the energy-topup steps to them without changing them; do not retry or split the request" ;;
    140007) gen_die 5 content-rejected "rewrite the prompt without sensitive content and run again; if it fails again, ask the user" ;;
    140101) gen_die 1 not-available "this model or generation type is not open for this account yet" "$GEN_CLI gen models" ;;
    140102|10003) gen_die 2 invalid-params "the platform rejected a parameter: ${msg:-see gen models for limits}; fix it and run again" ;;
    140104)
      gen_emit running "$running"
      gen_die 9 too-many-running "too many tasks are running; wait for one to finish first" "$GEN_CLI gen wait ${running%%,*}" ;;
    140103|140110) gen_die 9 busy "$(gen_retry_hint)" "$(gen_retry_next)" ;;
    140105) gen_die 1 request-conflict "the same request id was used with different parameters; rerun with --new" ;;
    140106) gen_die 1 task-not-found "check the task id" "$GEN_CLI gen list" ;;
    140107) gen_die 1 account-unavailable "the Builda account is restricted; ask the user to check the Builda App" ;;
    140109) gen_param_error --ref "png,jpg,webp up to 10 MiB" reference-unavailable ;;
    200461)
      if [ "$retriable" != "true" ]; then
        gen_die 1 service-unavailable "this capability is not configured on the Builda side right now (retrying will not help); if you used --ref, try without it, otherwise report to the user"
      fi ;;
    200460) gen_die 3 platform-account-missing "ask the user to sign out on the Builda website and sign in again by QR code, then re-authorize" "$GEN_CLI auth --force" ;;
  esac
  if [ "$retriable" = "true" ] || [[ "$AUTH_HTTP_STATUS" == 5* ]]; then
    gen_die 9 unavailable "$(gen_retry_hint)" "$(gen_retry_next)"
  fi
  gen_die 1 "http-$AUTH_HTTP_STATUS" "unexpected server response; report it to the user with the request-id"
}

gen_upload_ref() {
  local file="$1" ref
  [ -f "$file" ] || gen_param_error --ref "an existing png/jpg/webp file" reference-not-found
  gen_progress "step=upload-ref file=$file"
  gen_api POST /api/v1/agent/gen/references -H 'Content-Type: application/octet-stream' --data-binary "@$file"
  ref="$(gen_py get "$GEN_BODY" refId)"
  rm -f "$GEN_BODY"
  [ -n "$ref" ] || gen_die 1 reference-upload-failed "the reference image upload returned no id; report it to the user with the request-id"
  GEN_REF_ID="$ref"
}

# gen_estimate: when the model is unavailable, clear GEN_ESTIMATE_LINE instead of exiting; the caller reports the balance first, then exits.
gen_estimate() {
  local gen_type="$1" model="$2" count="$3"
  gen_api GET "/api/v1/agent/gen/models?genType=$gen_type"
  GEN_ESTIMATE_LINE="$(gen_py estimate "$GEN_BODY" "$gen_type" "$model" "$count" 2>/dev/null || true)"
  rm -f "$GEN_BODY"
}

gen_balance_value() {
  gen_api GET /api/v1/agent/gen/balance
  GEN_BALANCE="$(gen_py get "$GEN_BODY" energy)"
  rm -f "$GEN_BODY"
}

# gen_balance_soft is for successful wrap-up: the file is already written; a failed balance query just omits that line without changing the exit code.
gen_balance_soft() {
  local rc=0 f
  GEN_BALANCE=""
  authenticated_http_response "gen balance" "$BUILDA_BASE/api/v1/agent/gen/balance" 2>/dev/null || rc=$?
  if [ "$rc" = "0" ] && [[ "${AUTH_HTTP_STATUS:-}" == 2* ]]; then
    f="$(mktemp)"
    printf '%s' "$AUTH_HTTP_BODY" > "$f"
    GEN_BALANCE="$(gen_py get "$f" energy 2>/dev/null || true)"
    rm -f "$f"
  fi
}

# gen_check_out: outputs must stay inside the project: reject absolute paths, .. escaping the project, and toolchain and Git dirs.
gen_check_out() {
  [ -n "$GEN_OUT_ARG" ] || return 0
  gen_py check-out "$GEN_OUT_ARG" || gen_param_error -o "a relative path inside the project (not .builda-agent/ or .git/)" invalid-output
}

gen_interrupted() {
  trap - INT TERM
  echo >&2
  gen_emit status interrupted
  if [ -n "$GEN_TASK_ID" ]; then
    gen_emit next "$(gen_next_wait)"
  fi
  gen_progress "interrupted: only the local wait stopped; the task keeps running and is charged if it succeeds"
  gen_finish 130
}

gen_generate() {
  local gen_type="$1"
  shift
  local prompt="" model="" wait_s="$GEN_DEFAULT_WAIT" no_wait=0 max_energy="" dry_run=0 new=0 force=0
  local aspect="" count="" background="" faces="" extra="" max_refs=1 wait_given=0
  local media_parts=() media_key media_val
  local refs=() ref_ids=() f
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -p|--prompt) gen_need_value "$@"; shift; prompt="$1" ;;
      --prompt=*) prompt="${1#*=}" ;;
      -o|--out) gen_need_value "$@"; shift; GEN_OUT_ARG="$1" ;;
      --out=*) GEN_OUT_ARG="${1#*=}" ;;
      --ref) gen_need_value "$@"; shift; refs+=("$1") ;;
      --ref=*) refs+=("${1#*=}") ;;
      --model) gen_need_value "$@"; shift; model="$1" ;;
      --model=*) model="${1#*=}" ;;
      --wait) gen_need_value "$@"; shift; gen_parse_duration "$1"; wait_s="$GEN_DURATION"; wait_given=1 ;;
      --wait=*) gen_parse_duration "${1#*=}"; wait_s="$GEN_DURATION"; wait_given=1 ;;
      --no-wait) no_wait=1 ;;
      --aspect-ratio) gen_need_value "$@"; shift; aspect="$1" ;;
      --aspect-ratio=*) aspect="${1#*=}" ;;
      --count) gen_need_value "$@"; shift; count="$1" ;;
      --count=*) count="${1#*=}" ;;
      --background) gen_need_value "$@"; shift; background="$1" ;;
      --background=*) background="${1#*=}" ;;
      --faces) gen_need_value "$@"; shift; faces="$1" ;;
      --faces=*) faces="${1#*=}" ;;
      --title|--lyrics|--lyrics-file|--duration|--prompt-influence|--title=*|--lyrics=*|--lyrics-file=*|--duration=*|--prompt-influence=*)
        media_key="${1#--}"
        if [[ "$media_key" = *=* ]]; then media_val="${media_key#*=}"; media_key="${media_key%%=*}"
        else gen_need_value "$@"; shift; media_val="$1"; fi
        case "$media_key" in
          title|lyrics|lyrics-file)
            [ "$gen_type" = music ] || gen_param_error "--$media_key" "music only"
            if [ "$media_key" = lyrics-file ]; then
              [ -f "$media_val" ] || gen_param_error --lyrics-file "existing UTF-8 file"
              media_val="$(python3 -c 'import sys,base64; print(base64.b64encode(open(sys.argv[1],encoding="utf-8-sig",newline="").read().encode("utf-8")).decode())' "$media_val" 2>/dev/null)" || gen_param_error --lyrics-file "valid UTF-8 file"
              media_key=lyrics64
            else
              media_val="$(printf '%s' "$media_val" | python3 -c 'import sys,base64; print(base64.b64encode(sys.stdin.buffer.read()).decode())')"; media_key="${media_key}64"
            fi ;;
          duration|prompt-influence)
            [[ "$gen_type" = audio || "$gen_type" = music ]] || gen_param_error "--$media_key" "audio or music only"
            [[ "$media_val" =~ ^[0-9]+([.][0-9]+)?$ ]] || gen_param_error "--$media_key" "nonnegative decimal"
            if [ "$media_key" = prompt-influence ]; then
              [ "$gen_type" = audio ] || gen_param_error --prompt-influence "audio only"
              media_key=promptInfluence
            fi ;;
        esac
        media_parts+=("$media_key=$media_val") ;;
      --instrumental|--loop)
        media_key="${1#--}"
        if [ "$media_key" = instrumental ]; then
          [ "$gen_type" = music ] || gen_param_error --instrumental "music only"
        else
          [ "$gen_type" = audio ] || gen_param_error --loop "audio only"
        fi
        media_parts+=("$media_key=true") ;;
      --max-energy) gen_need_value "$@"; shift; max_energy="$1" ;;
      --max-energy=*) max_energy="${1#*=}" ;;
      --dry-run) dry_run=1 ;;
      --new) new=1 ;;
      --force) force=1 ;;
      --json) GEN_JSON=1 ;;
      -h|--help) gen_usage; gen_finish 0 ;;
      *) gen_param_error "$1" "see gen --help" unknown-option "unknown option $1" ;;
    esac
    shift
  done
  gen_check_out
  [ "$wait_given$no_wait" != "11" ] || gen_param_error --no-wait "either --wait <dur> or --no-wait, not both" conflicting-options
  [ -n "${prompt//[[:space:]]/}" ] || gen_param_error --prompt "non-empty text describing the $gen_type" prompt-required
  [ -z "$max_energy" ] || [[ "$max_energy" =~ ^[0-9]+$ ]] || gen_param_error --max-energy "a whole number" invalid-max-energy
  gen_type_params "$gen_type" "$aspect" "$count" "$background" "$faces"
  extra="$GEN_EXTRA"; max_refs="$GEN_MAX_REFS"
  if [ "${#media_parts[@]}" -gt 0 ]; then
    extra="$(python3 -c 'import sys; d=dict(p.split("=",1) for a in sys.argv[1:] for p in a.split(";") if p); print(";".join(k+"="+d[k] for k in sorted(d)))' "$extra" "${media_parts[@]}")"
  fi
  [ "${#refs[@]}" -le "$max_refs" ] || gen_param_error --ref "<= $max_refs images"
  for f in "${refs[@]+"${refs[@]}"}"; do
    [ -f "$f" ] || gen_param_error --ref "an existing png/jpg/webp file" reference-not-found "reference file not found: $f"
    gen_py check-ref "$f" || gen_param_error --ref "png,jpg,webp image content up to 10 MiB" reference-invalid "not a png/jpg/webp image (checked by file content) or larger than 10 MiB: $f"
  done
  gen_need_auth
  if [ "$dry_run" = "1" ]; then
    # dry-run reaches the same verdict as a real submit: when a new charge would occur and the target file exists, also refuse with 8.
    gen_request_fresh "$gen_type" "$model" "$prompt" "$new" "$extra" "${#refs[@]}"
    gen_check_conflict "$gen_type" "${count:-1}" "$force"
  fi
  gen_budget "$gen_type" "$model" "$dry_run" "$max_energy" "${count:-1}" "$extra" "${#refs[@]}" "$(printf '%s' "$prompt" | python3 -c 'import sys; print(len(sys.stdin.read()))')"
  for f in "${refs[@]+"${refs[@]}"}"; do gen_upload_ref "$f"; ref_ids+=("$GEN_REF_ID"); done
  GEN_COUNT="${count:-1}"
  GEN_FROM_GENERATE=1
  gen_submit "$gen_type" "$model" "$prompt" "$new" "$force" "$extra" "${ref_ids[@]+"${ref_ids[@]}"}"
  if [ "$no_wait" = "1" ]; then
    gen_emit status pending
    gen_emit next "$(gen_next_wait)"
    gen_finish 0
  fi
  gen_wait_task "$gen_type" "$wait_s" "$force"
}

# gen_type_params validates type-specific params and builds the normalized extra ("k=v;k=v" sorted by key); the platform owns ranges, locally we only block obvious errors.
gen_type_params() {
  local gen_type="$1" aspect="$2" count="$3" background="$4" faces="$5" parts=""
  GEN_MAX_REFS=4
  case "$gen_type" in
    audio|music)
      GEN_MAX_REFS=1
      [ "$gen_type" != music ] || GEN_MAX_REFS=0
      [ -z "$aspect" ] || gen_param_error --aspect-ratio "image only" option-not-supported
      [ -z "$count" ] || parts="count=$count"
      [ -z "$background" ] || gen_param_error --background "image only" option-not-supported
      [ -z "$faces" ] || gen_param_error --faces "model3d only" option-not-supported ;;
    image)
      [ -z "$faces" ] || gen_param_error --faces "model3d only" option-not-supported
      [ -z "$aspect" ] || [[ "$aspect" =~ ^[0-9]+:[0-9]+$ ]] || gen_param_error --aspect-ratio "W:H, see gen models image" invalid-params
      case "$background" in ""|auto|transparent|opaque) ;; *) gen_param_error --background "auto,transparent,opaque" ;; esac
      [ -z "$aspect" ] || parts="aspectRatio=$aspect"
      [ -z "$background" ] || parts="${parts:+$parts;}backgroundMode=$background"
      [ -z "$count" ] || parts="${parts:+$parts;}count=$count" ;;
    model3d)
      [ -z "$aspect" ] || gen_param_error --aspect-ratio "image only" option-not-supported
      [ -z "$count" ] || gen_param_error --count "image only" option-not-supported
      [ -z "$background" ] || gen_param_error --background "image only" option-not-supported
      [ -z "$faces" ] || parts="targetFaces=$faces" ;;
  esac
  GEN_EXTRA="$parts"
}

# gen_budget looks up model prices only for --dry-run / --max-energy; the estimate is an upper bound (audio assumes 120 seconds).
gen_budget() {
  local gen_type="$1" model="$2" dry_run="$3" max_energy="$4" count="$5" extra="$6" ref_count="$7" prompt_len="$8" line est bad
  # Before every generation, validate locally with platform limits: dry-run and real submit reach the same verdict; out-of-range params never reach submit.
  # dry-run reports the balance first: even if the model isn't enabled, the agent learns both "not enabled" and "how much balance" at once.
  if [ "$dry_run" = "1" ]; then
    gen_balance_value
    gen_emit energy-balance "$GEN_BALANCE"
  fi
  gen_api GET "/api/v1/agent/gen/models?genType=$gen_type"
  local vrc=0
  bad="$(gen_py validate "$GEN_BODY" "$gen_type" "$model" "$extra" "$ref_count" "$prompt_len" "$GEN_OUT_ARG")" || vrc=$?
  if [ "$vrc" = "3" ]; then
    rm -f "$GEN_BODY"
    gen_emit message "genType not open: no $gen_type model is available for this account yet (same as submit error 140101)"
    gen_die 1 not-available "the platform has not opened $gen_type generation for this account yet" "$GEN_CLI gen models"
  fi
  if [ "$vrc" != "0" ]; then
    rm -f "$GEN_BODY"
    gen_emit message "$(printf '%s' "$bad" | cut -f3)"
    gen_param_error "$(printf '%s' "$bad" | cut -f1)" "$(printf '%s' "$bad" | cut -f2)"
  fi
  GEN_ESTIMATE_LINE="$(gen_py estimate "$GEN_BODY" "$gen_type" "$model" "$count" 2>/dev/null || true)"
  rm -f "$GEN_BODY"
  line="$GEN_ESTIMATE_LINE"
  [ -n "$line" ] || gen_die 1 not-available "no price is available for this $gen_type model yet" "$GEN_CLI gen models"
  est="$(printf '%s' "$line" | cut -f2)"
  [ "$dry_run" = "1" ] || [ -n "$max_energy" ] || return 0
  if [ "$dry_run" = "1" ]; then
    gen_emit model "$(printf '%s' "$line" | cut -f1)"
    gen_emit energy-estimate "$est"
    gen_emit status dry-run
    if [ -n "$max_energy" ] && [ "$est" -gt "$max_energy" ] 2>/dev/null; then
      gen_die 4 over-budget "the estimate exceeds --max-energy $max_energy; ask the user before raising it"
    fi
    if [ "${GEN_BALANCE:-0}" -lt "$est" ] 2>/dev/null; then
      gen_emit energy-topup "$GEN_TOPUP_HINT"
      gen_die 4 insufficient-energy "the balance is below this estimate; relay the energy-topup steps to the user without changing them before generating"
    fi
    gen_finish 0
  fi
  if [ "$est" -gt "$max_energy" ] 2>/dev/null; then
    gen_emit energy-estimate "$est"
    gen_die 4 over-budget "the estimate exceeds --max-energy $max_energy; ask the user before raising it"
  fi
}

# gen_request_fresh decides whether this request incurs a new charge (first time, --new after the last one finished, or the last same-param request failed).
# With reference images the refId can't be predicted locally, so treat it as a new request.
gen_request_fresh() {
  local gen_type="$1" model="$2" prompt="$3" new="$4" extra="$5" ref_count="$6" base _rid _body state
  GEN_FRESH=1
  [ "$ref_count" = "0" ] || return 0
  { read -r base; read -r _rid; read -r _body; } < <(gen_py request "$gen_type" "$model" "$prompt" "" "$extra")
  state="$(gen_py request-state "$GEN_DIR" "$base")"
  [ -n "$state" ] || return 0                                # no record: new request
  if [ "$(printf '%s' "$state" | cut -f2)" != "1" ]; then GEN_FRESH=0; return 0; fi   # last one still running: resume
  [ "$new" = "1" ] && return 0                               # finished + --new: new request
  [ "$(gen_py ledger-get "$GEN_DIR" "$(printf '%s' "$state" | cut -f3)" status)" = "failed" ] && return 0  # last one failed: resubmit
  GEN_FRESH=0                                                # done: reuse
}

# gen_check_conflict: when a new charge would occur, check target files first and refuse before submit on conflict (reporting the actually conflicting file).
gen_check_conflict() {
  local gen_type="$1" count="$2" force="$3" hit
  [ "$GEN_FRESH" = "1" ] && [ "$force" != "1" ] && [ -n "$GEN_OUT_ARG" ] || return 0
  hit="$(gen_py out-free "$GEN_OUT_ARG" "$gen_type" "$count")" || \
    gen_die 8 output-exists "$(gen_quote "$hit") already exists; pass another -o, or add --force if the user agrees to overwrite (nothing was submitted or charged)"
}

gen_submit() {
  local gen_type="$1" model="$2" prompt="$3" new="$4" force="$5" extra="$6"
  shift 6
  local base request_id body state nonce="" done_flag="" prev_task="" est status reused=0 fresh=0
  mkdir -p "$GEN_DIR"
  { read -r base; read -r request_id; read -r body; } < <(gen_py request "$gen_type" "$model" "$prompt" "" "$extra" "$@")
  state="$(gen_py request-state "$GEN_DIR" "$base")"
  if [ -n "$state" ]; then
    nonce="$(printf '%s' "$state" | cut -f1)"
    done_flag="$(printf '%s' "$state" | cut -f2)"
    prev_task="$(printf '%s' "$state" | cut -f3)"
  fi
  [ -n "$state" ] || fresh=1
  local prev_failed=0
  if [ -n "$state" ] && [ "$done_flag" = "1" ] && [ "$(gen_py ledger-get "$GEN_DIR" "$prev_task" status)" = "failed" ]; then prev_failed=1; fi
  if { [ "$new" = "1" ] || [ "$prev_failed" = "1" ]; } && { [ -z "$state" ] || [ "$done_flag" = "1" ]; }; then
    # --new, or the last same-param request failed (failures aren't charged): derive a new nonce and resubmit, no longer reusing the failed result.
    nonce="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
    done_flag=0
    fresh=1
    [ "$prev_failed" != "1" ] || gen_emit hint "the previous identical request failed (not charged); submitted it again as a new generation"
  elif [ -n "$state" ] && [ "$new" = "1" ]; then
    # A same-param request is still in progress: --new has no effect; resume the original task and say so explicitly.
    gen_emit new-ignored yes
    gen_emit hint "the identical earlier request (task $prev_task) is still running, so --new was not applied and this run continues it; run --new again after it finishes for another take"
    gen_progress "--new ignored: the identical earlier request is still running"
  elif [ -n "$state" ]; then
    reused=1
  fi
  if [ -n "$nonce" ]; then
    { read -r base; read -r request_id; read -r body; } < <(gen_py request "$gen_type" "$model" "$prompt" "$nonce" "$extra" "$@")
  fi
  # Requests that incur a new charge check target files first: refuse before submit on conflict; never charge first and then report the file exists.
  GEN_FRESH="$fresh"
  gen_check_conflict "$gen_type" "${GEN_COUNT:-1}" "$force"
  gen_progress "step=submit type=$gen_type"
  gen_api POST /api/v1/agent/gen/tasks -H 'Content-Type: application/json' --data-binary "$body"
  GEN_TASK_ID="$(gen_py get "$GEN_BODY" taskId)"
  est="$(gen_py get "$GEN_BODY" estimatedEnergy)"
  status="$(gen_py get "$GEN_BODY" status)"
  rm -f "$GEN_BODY"
  [ -n "$GEN_TASK_ID" ] || gen_die 1 submit-failed "the platform returned no task id; report it to the user with the request-id"
  if [ "$status" = "failed" ] && [ "$new" != "1" ] && [ "${GEN_RESUBMITTED:-0}" != "1" ]; then
    # The platform replayed a failed same-param task (when the local ledger is missing): failures aren't charged, so switch nonce and resubmit once automatically.
    GEN_RESUBMITTED=1
    GEN_TASK_ID=""
    gen_emit hint "the platform returned an earlier failed attempt of this request (not charged); submitted it again as a new generation"
    nonce="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
    { read -r base; read -r request_id; read -r body; } < <(gen_py request "$gen_type" "$model" "$prompt" "$nonce" "$extra" "$@")
    fresh=1
    gen_api POST /api/v1/agent/gen/tasks -H 'Content-Type: application/json' --data-binary "$body"
    GEN_TASK_ID="$(gen_py get "$GEN_BODY" taskId)"
    est="$(gen_py get "$GEN_BODY" estimatedEnergy)"
    status="$(gen_py get "$GEN_BODY" status)"
    rm -f "$GEN_BODY"
    [ -n "$GEN_TASK_ID" ] || gen_die 1 submit-failed "the platform returned no task id; report it to the user with the request-id"
  fi
  trap gen_interrupted INT TERM
  gen_py request-save "$GEN_DIR" "$base" "$nonce" "${done_flag:-0}" "$GEN_TASK_ID"
  gen_py ledger-task "$GEN_DIR" "$GEN_TASK_ID" "genType=$gen_type" "model=$model" "prompt=$prompt" "out=$GEN_OUT_ARG" "status=${status:-pending}" "params=$extra"
  gen_emit task "$GEN_TASK_ID"
  if [ "$fresh" = "1" ] && { [ "$new" = "1" ] || [ "${GEN_RESUBMITTED:-0}" = "1" ] || [ -n "$nonce" ]; }; then
    # new-generation=yes: a new generation was submitted; charged only on success; failures and moderation rejections aren't charged.
    gen_progress "submitted as a new generation; it is charged only if it succeeds"
    gen_emit new-generation yes
  fi
  GEN_SUBMIT_STATUS="${status:-}"
  if [ "$reused" = "1" ] && [ "$prev_task" = "$GEN_TASK_ID" ]; then
    gen_emit reused yes
    GEN_REUSED_EMITTED=1
    gen_progress "same request as before: using task $GEN_TASK_ID (no new charge)"
  fi
  gen_emit energy-estimate "${est:-0}"
}

# gen_wait_task polls with a cap; done -> download and report actual cost and balance; failed -> 5; timeout -> 6.
gen_wait_task() {
  local gen_type="$1" wait_s="$2" force="$3" start now elapsed interval max_interval status last_beat=0
  start="$(date +%s)"
  interval=2; max_interval=5
  [ "$gen_type" != "model3d" ] || { interval=5; max_interval=30; }
  trap gen_interrupted INT TERM
  while :; do
    gen_api GET "/api/v1/agent/gen/tasks/$GEN_TASK_ID"
    status="$(gen_py get "$GEN_BODY" status)"
    case "$status" in
      done) gen_task_done "$gen_type" "$force"; return ;;
      failed) gen_task_failed ;;
    esac
    rm -f "$GEN_BODY"
    now="$(date +%s)"; elapsed=$((now - start))
    if [ "$elapsed" -ge "$wait_s" ]; then
      gen_py ledger-task "$GEN_DIR" "$GEN_TASK_ID" status=running
      gen_emit status running
      gen_emit hint "still generating; run next to keep waiting (no new charge)"
      gen_emit next "$(gen_next_wait)"
      gen_finish 6
    fi
    if [ -t 2 ]; then
      printf '\rgen| status=%s elapsed=%ss ' "${status:-pending}" "$elapsed" >&2
    elif [ $((now - last_beat)) -ge 30 ]; then
      gen_progress "status=${status:-pending} elapsed=${elapsed}s"
      last_beat="$now"
    fi
    sleep "$interval"
    interval=$(( interval * 3 / 2 )); [ "$interval" -le "$max_interval" ] || interval="$max_interval"
  done
}

gen_task_failed() {
  local code reason
  code="$(gen_py get "$GEN_BODY" failCode)"
  reason="$(gen_py get "$GEN_BODY" failReason)"
  rm -f "$GEN_BODY"
  gen_py ledger-task "$GEN_DIR" "$GEN_TASK_ID" status=failed energyCost=0
  gen_py request-done-for-task "$GEN_DIR" "$GEN_TASK_ID"
  gen_emit status failed
  gen_emit fail-code "${code:-unknown}"
  [ -z "$reason" ] || gen_emit fail-reason "$reason"
  gen_emit energy-cost 0
  if [ "$code" = "content_violation" ]; then
    gen_die 5 content-rejected "rewrite the prompt without sensitive content and run again (a changed prompt is a new request); if it fails again, ask the user"
  fi
  gen_die 5 task-failed "no Credits were charged; running the same command again submits a fresh attempt automatically; if it fails again, report to the user (it may also be a content rejection the platform did not label)"
}

gen_task_done() {
  local gen_type="$1" force="$2" task_file cost settled prior files="" url md5 size dest
  [ -t 2 ] && printf '\r\033[K' >&2
  task_file="$GEN_BODY"
  cost="$(gen_py get "$task_file" energyCost)"
  settled="$(gen_py get "$task_file" energySettled)"
  prior="$(gen_py ledger-get "$GEN_DIR" "$GEN_TASK_ID" status)"
  # The task is done and settled on the platform: record and report the cost first, then handle the local download (a failed download must not hide that Credits were charged).
  gen_py ledger-task "$GEN_DIR" "$GEN_TASK_ID" status=done "energyCost=${cost:-0}" "model=$(gen_py get "$task_file" model)"
  gen_py request-done-for-task "$GEN_DIR" "$GEN_TASK_ID"
  gen_emit status done
  # This delivers a previously completed task (local ledger or platform replay shows done): explicitly mark it as an old result and when it was generated.
  local earlier=0 created
  if [ "$prior" = "done" ] || [ "${GEN_SUBMIT_STATUS:-}" = "done" ]; then earlier=1; fi
  if [ "$earlier" = "1" ]; then
    created="$(gen_py task-time "$task_file")"
    [ -n "$created" ] || created="$(gen_py ledger-time "$GEN_DIR" "$GEN_TASK_ID")"
    [ "${GEN_REUSED_EMITTED:-0}" = "1" ] || gen_emit reused yes
    [ -z "$created" ] || gen_emit reused-from "$created"
  fi
  if [ "$earlier" = "1" ]; then
    # The task was already completed and settled: this is only a reuse/re-download, cost this time is 0, and the original task's cost is given separately.
    gen_emit energy-cost 0
    gen_emit task-energy-cost "${cost:-0}"
  else
    gen_emit energy-cost "${cost:-0}"
  fi
  while IFS=$'\t' read -r url md5 size dest dims; do
    [ -n "$url" ] || continue
    gen_download_one "$url" "$md5" "$dest" "$force" "$dims"
    files="$files$GEN_FINAL_DEST"$'\n'
  done < <(gen_py plan "$task_file" "$GEN_OUT_ARG" "$GEN_TASK_ID" "$gen_type" || echo "")
  rm -f "$task_file"
  [ -n "$files" ] || gen_die 7 no-output "the task finished without files" "$GEN_CLI gen status $GEN_TASK_ID"
  gen_py ledger-task "$GEN_DIR" "$GEN_TASK_ID" "files=$files"
  [ "$settled" = "true" ] || gen_emit energy-settled no
  gen_balance_soft
  [ -z "$GEN_BALANCE" ] || gen_emit energy-balance "$GEN_BALANCE"
  [ "$GEN_BALANCE" != "0" ] || gen_emit energy-topup "$GEN_TOPUP_HINT"
  if [ "$earlier" = "1" ] && [ "${GEN_FROM_GENERATE:-0}" = "1" ]; then
    # After the platform fixes an issue, the same request still hits the old task: use hint to say this is an old result (next= holds only commands, no explanations).
    gen_emit hint "this is the earlier result generated at ${created:-an earlier time} (no new charge); tell the user it is not a new generation, and if they want a fresh one, rerun with --new (charged)"
  fi
  gen_finish 0
}

# gen_download_one writes atomically: .part in the same dir -> md5 check -> rename; an existing file with identical content counts as success.
gen_download_one() {
  local url="$1" md5="$2" dest="$3" force="$4" dims="${5:-}" dir part got crc=0
  GEN_FINAL_DEST="$dest"
  if [ -f "$dest" ]; then
    if [ -n "$md5" ] && [ "$(gen_py md5 "$dest")" = "$md5" ]; then
      gen_emit file "$dest"
      gen_emit md5 "$md5"
      [ -z "$dims" ] || gen_emit dimensions "$dims"
      gen_note_renamed "$dest"
      return
    fi
    [ "$force" = "1" ] || gen_die 8 output-exists "$dest already exists with different content; pass another -o or add --force"
  fi
  dir="$(dirname "$dest")"
  # Local write problems (can't create dir, read-only) are reported as write-failed: re-downloading won't help, so don't lead the agent into a retry loop.
  mkdir -p "$dir" 2>/dev/null || gen_die 1 write-failed "cannot create directory $dir (check the path and permissions); the task is done and will not be charged again: fix the path, then run gen download $GEN_TASK_ID -o <a writable path>"
  [ -w "$dir" ] || gen_die 1 write-failed "cannot write into $dir (read-only); the task is done and will not be charged again: fix the permissions, then run gen download $GEN_TASK_ID -o <a writable path>"
  part="$dir/.$(basename "$dest").part"
  gen_progress "step=download file=$dest"
  curl -fsSL --retry 3 --retry-delay 2 -o "$part" "$url" || crc=$?
  if [ "$crc" = "23" ]; then
    rm -f "$part"
    gen_die 1 write-failed "cannot write into $dir (read-only or disk full); the task is done and will not be charged again: fix the path or permissions, then run gen download $GEN_TASK_ID -o <a writable path>"
  fi
  if [ "$crc" != "0" ]; then
    rm -f "$part"
    gen_die 7 download-failed "the download failed; the task is done and is not charged again" "$GEN_CLI gen download $GEN_TASK_ID -o $(gen_quote "$dest")"
  fi
  got="$(gen_py md5 "$part")"
  if [ -n "$md5" ] && [ "$got" != "$md5" ]; then
    rm -f "$part"
    gen_die 7 checksum-mismatch "the downloaded file failed its checksum; download it again" "$GEN_CLI gen download $GEN_TASK_ID -o $(gen_quote "$dest")"
  fi
  # The extension follows the file content: correct it when platform format metadata doesn't match the actual data (engines may decode by extension).
  local planned real
  planned="${dest##*.}"
  real="$(gen_py sniff "$part" "$planned")"
  if [ "$real" != "$planned" ]; then
    dest="${dest%.*}.$real"
    if [ -f "$dest" ] && [ "$(gen_py md5 "$dest")" != "$got" ] && [ "$force" != "1" ]; then
      rm -f "$part"
      gen_die 8 output-exists "$dest already exists with different content; pass another -o or add --force"
    fi
  fi
  mv -f "$part" "$dest"
  GEN_FINAL_DEST="$dest"
  gen_emit file "$dest"
  gen_emit md5 "$got"
  [ -z "$dims" ] || gen_emit dimensions "$dims"
  gen_note_renamed "$dest"
}

# gen_note_renamed: when the actual extension differs from what -o asked for (corrected by content or the platform's returned format), say so explicitly so code doesn't hardcode a wrong file name.
gen_note_renamed() {
  local final="$1" want
  [ "${GEN_RENAME_NOTED:-0}" = "0" ] || return 0
  [ -n "$GEN_OUT_ARG" ] && [ ! -d "$GEN_OUT_ARG" ] && [[ "$GEN_OUT_ARG" != */ ]] || return 0
  case "$(basename "$GEN_OUT_ARG")" in *.*) ;; *) return 0 ;; esac
  want="${GEN_OUT_ARG##*.}"
  [ "$(printf '%s' "$want" | tr 'A-Z' 'a-z')" != "${final##*.}" ] || return 0
  GEN_RENAME_NOTED=1
  gen_emit requested-file "$GEN_OUT_ARG"
  gen_progress "warning: saved as $final instead of $GEN_OUT_ARG to match the real file format"
}

gen_task_command() {
  local sub="$1"
  shift
  local wait_s="$GEN_DEFAULT_WAIT" force=0
  GEN_TASK_ID=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -o|--out) gen_need_value "$@"; shift; GEN_OUT_ARG="$1" ;;
      --out=*) GEN_OUT_ARG="${1#*=}" ;;
      --wait) gen_need_value "$@"; shift; gen_parse_duration "$1"; wait_s="$GEN_DURATION" ;;
      --wait=*) gen_parse_duration "${1#*=}"; wait_s="$GEN_DURATION" ;;
      --force) force=1 ;;
      --json) GEN_JSON=1 ;;
      -h|--help) gen_usage; gen_finish 0 ;;
      -*) gen_param_error "$1" "see gen --help" unknown-option "unknown option $1" ;;
      *) [ -z "$GEN_TASK_ID" ] || gen_param_error task "a single task id" unexpected-argument; GEN_TASK_ID="$1" ;;
    esac
    shift
  done
  [ -n "$GEN_TASK_ID" ] || gen_die 2 task-required "pass the task id" "$GEN_CLI gen list"
  [[ "$GEN_TASK_ID" =~ ^[A-Za-z0-9_:.-]{1,128}$ ]] || gen_die 2 invalid-task-id "task ids look like the task= value printed when generating" "$GEN_CLI gen list"
  gen_check_out
  [ -n "$GEN_OUT_ARG" ] || GEN_OUT_ARG="$(gen_py ledger-out "$GEN_DIR" "$GEN_TASK_ID")"
  gen_need_auth
  gen_emit task "$GEN_TASK_ID"
  case "$sub" in
    wait)
      gen_task_type
      gen_wait_task "$GEN_TASK_TYPE" "$wait_s" "$force" ;;
    download)
      gen_api GET "/api/v1/agent/gen/tasks/$GEN_TASK_ID"
      case "$(gen_py get "$GEN_BODY" status)" in
        done) gen_task_done "$(gen_py get "$GEN_BODY" genType)" "$force" ;;
        failed) gen_task_failed ;;
        *) rm -f "$GEN_BODY"; gen_emit status running; gen_die 6 not-finished "the task is still generating" "$(gen_next_wait)" ;;
      esac ;;
    status)
      gen_api GET "/api/v1/agent/gen/tasks/$GEN_TASK_ID"
      local st; st="$(gen_py get "$GEN_BODY" status)"; [ "$st" != processing ] || st=running
      gen_emit status "$st"
      gen_emit type "$(gen_py get "$GEN_BODY" genType)"
      gen_emit model "$(gen_py get "$GEN_BODY" model)"
      local params; params="$(gen_py ledger-get "$GEN_DIR" "$GEN_TASK_ID" params)"
      [ -z "$params" ] || gen_emit params "$params"
      gen_emit energy-estimate "$(gen_py get "$GEN_BODY" estimatedEnergy)"
      # In-progress tasks aren't settled yet: don't output energy-cost, to avoid it being read as "free".
      case "$st" in done|failed) gen_emit energy-cost "$(gen_py get "$GEN_BODY" energyCost)" ;; esac
      local fc fr; fc="$(gen_py get "$GEN_BODY" failCode)"; fr="$(gen_py get "$GEN_BODY" failReason)"
      [ -z "$fc" ] || gen_emit fail-code "$fc"
      [ -z "$fr" ] || gen_emit fail-reason "$fr"
      rm -f "$GEN_BODY"
      gen_finish 0 ;;
  esac
}

gen_task_type() {
  local t
  gen_api GET "/api/v1/agent/gen/tasks/$GEN_TASK_ID"
  t="$(gen_py get "$GEN_BODY" genType)"
  rm -f "$GEN_BODY"
  GEN_TASK_TYPE="${t:-audio}"
}

gen_info_command() {
  local sub="$1"
  shift
  local limit=20 type="" gen_type="" opt
  while [ "$#" -gt 0 ]; do
    opt="${1%%=*}"
    # Each subcommand accepts only its own options; unrelated options error out instead of being silently ignored.
    case "$sub:$opt" in
      *:--json) GEN_JSON=1 ;;
      *:-h|*:--help) gen_usage; gen_finish 0 ;;
      list:--limit|usage:--limit)
        if [ "$1" = "$opt" ]; then gen_need_value "$@"; shift; limit="$1"; else limit="${1#*=}"; fi ;;
      usage:--type)
        if [ "$1" = "$opt" ]; then gen_need_value "$@"; shift; type="$1"; else type="${1#*=}"; fi ;;
      list:-*|balance:-*|models:-*|usage:-*) gen_param_error "$1" "see gen --help" unknown-option "$1 is not an option of gen $sub" ;;
      list:*|models:*)
        case "$1" in audio|music|image|model3d) gen_type="$1" ;; *) gen_param_error type "audio,music,image,model3d" invalid-type "unknown generation type: $1" ;; esac ;;
      *) gen_param_error "$1" "see gen --help" unexpected-argument "gen $sub takes no argument $1" ;;
    esac
    shift
  done
  [[ "$limit" =~ ^[1-9][0-9]*$ ]] || gen_param_error --limit "a positive whole number" invalid-limit
  if [ "$sub" = "usage" ]; then
    [ "$limit" -le 50 ] || gen_param_error --limit "1..50" invalid-limit
    case "$type" in ""|all|income|expense) ;; *) gen_param_error --type "all,income,expense" invalid-type ;; esac
  fi
  case "$sub" in
    list)
      if [ "$GEN_JSON" = "1" ]; then gen_py list "$GEN_DIR" "$limit" json "$gen_type"; rm -f "$GEN_RESULT_FILE"; exit 0; fi
      gen_py list "$GEN_DIR" "$limit" text "$gen_type"
      gen_finish 0 ;;
  esac
  gen_need_auth
  case "$sub" in
    balance)
      gen_api GET /api/v1/agent/gen/balance
      local bal; bal="$(gen_py get "$GEN_BODY" energy)"
      gen_emit energy-balance "$bal"
      [ "${bal:-0}" != "0" ] || gen_emit energy-topup "$GEN_TOPUP_HINT"
      gen_emit energy-total-income "$(gen_py get "$GEN_BODY" totalIncome)"
      gen_emit energy-total-expend "$(gen_py get "$GEN_BODY" totalExpend)" ;;
    models)
      gen_api GET "/api/v1/agent/gen/models?genType=$gen_type"
      if [ "$GEN_JSON" = "1" ]; then cat "$GEN_BODY"; echo; rm -f "$GEN_BODY" "$GEN_RESULT_FILE"; exit 0; fi
      gen_py models "$GEN_BODY" ;;
    usage)
      gen_api GET "/api/v1/agent/gen/transactions?size=$limit&type=$type"
      if [ "$GEN_JSON" = "1" ]; then cat "$GEN_BODY"; echo; rm -f "$GEN_BODY" "$GEN_RESULT_FILE"; exit 0; fi
      gen_py usage "$GEN_BODY" ;;
  esac
  rm -f "$GEN_BODY"
  gen_finish 0
}

gen_command() {
  local sub="${1:-}"
  shift || true
  need_python3
  GEN_RESULT_FILE="$(mktemp)"
  local arg
  # --json takes effect before parsing any args: param errors must also output JSON, regardless of arg order.
  for arg in "$@"; do [ "$arg" != "--json" ] || GEN_JSON=1; done
  case "$sub" in
    audio|music|image|model3d) GEN_IS_GENERATE=1; gen_generate "$sub" "$@" ;;
    speech|video) gen_die 1 not-supported-by-cli "this toolchain version cannot generate $sub yet; update the toolchain, and if it is still unsupported the capability has not been released" "$GEN_CLI check" ;;
    wait|status|download) gen_task_command "$sub" "$@" ;;
    list|balance|models|usage) gen_info_command "$sub" "$@" ;;
    ""|-h|--help|help) gen_usage; gen_finish 0 ;;
    *) gen_die 2 unknown-command "unknown gen command: $sub" "$GEN_CLI gen --help" ;;
  esac
}

need_python3() {
  command -v python3 >/dev/null 2>&1 || { echo "backend commands require python3 for JSON and ELF validation." >&2; exit 1; }
}

open_authorize_url() {
  local url="$1"
  if [ -n "${BROWSER:-}" ]; then
    "$BROWSER" "$url" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 &
  elif command -v wslview >/dev/null 2>&1; then
    wslview "$url" >/dev/null 2>&1 &
  else
    return 1
  fi
}

save_grant() {
  local grant="$1"
  [ -n "$grant" ] || { echo "empty grant" >&2; exit 1; }
  mkdir -p "$AUTH_DIR"
  printf '%s' "$grant" > "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  echo "Agent grant saved for 30 minutes."
}

save_refresh() {
  local refresh="$1"
  [ -n "$refresh" ] || return 0
  mkdir -p "$AUTH_DIR"
  printf '%s' "$refresh" > "$REFRESH_FILE"
  chmod 600 "$REFRESH_FILE"
  echo "Agent authorization saved for 30 days."
}

grant_needs_refresh() {
  [ -f "$REFRESH_FILE" ] || return 1
  [ -f "$TOKEN_FILE" ] || return 0
  local now mtime age
  now="$(date +%s)"
  if mtime="$(stat -c %Y "$TOKEN_FILE" 2>/dev/null)"; then
    :
  elif mtime="$(stat -f %m "$TOKEN_FILE" 2>/dev/null)"; then
    :
  else
    return 1
  fi
  age=$((now - mtime))
  [ "$age" -ge 1500 ]
}

grant_is_fresh() {
  [ -f "$TOKEN_FILE" ] || return 1
  local now mtime age
  now="$(date +%s)"
  if mtime="$(stat -c %Y "$TOKEN_FILE" 2>/dev/null)"; then
    :
  elif mtime="$(stat -f %m "$TOKEN_FILE" 2>/dev/null)"; then
    :
  else
    return 1
  fi
  age=$((now - mtime))
  [ "$age" -lt 1500 ]
}

refresh_grant() {
  [ -f "$REFRESH_FILE" ] || return 1
  local refresh resp grant
  refresh="$(cat "$REFRESH_FILE")"
  [ -n "$refresh" ] || return 1
  resp="$(curl -sS -X POST "$BUILDA_BASE/api/v1/agent/auth/refresh" -H 'Content-Type: application/json' -d "{\"refresh_token\":\"$refresh\"}")" || return 1
  grant="$(printf '%s' "$resp" | json_field token)"
  [ -n "$grant" ] || return 1
  save_grant "$grant" >/dev/null
  echo "Agent grant refreshed automatically."
}

auth_with_pair_code() {
  local code="$1"
  resp="$(curl -sS -X POST "$BUILDA_BASE/api/v1/agent/exchange" -H 'Content-Type: application/json' -d "{\"code\":\"$code\"}")"
  grant="$(printf '%s' "$resp" | json_field token)"
  if [ -z "$grant" ]; then
    echo "Pair code exchange failed or expired. Starting browser authorization instead." >&2
    auth_with_browser
    return
  fi
  save_grant "$grant"
  save_refresh "$(printf '%s' "$resp" | json_field refresh_token)"
}

auth_with_browser() {
  auth_start_body='{}'
  if [ -n "$BUILDA_SITE_ORIGIN" ]; then
    auth_start_body="$(printf '{\"site_origin\":\"%s\"}' "$BUILDA_SITE_ORIGIN")"
  fi
  resp="$(http_request "auth start" -X POST "$BUILDA_BASE/api/v1/agent/auth/start" -H 'Content-Type: application/json' -d "$auth_start_body")"
  auth_id="$(printf '%s' "$resp" | json_field auth_id)"
  authorize_url="$(printf '%s' "$resp" | json_field authorize_url)"
  activate_url="$(printf '%s' "$resp" | json_field activate_url)"
  user_code="$(printf '%s' "$resp" | json_field user_code)"
  interval="$(printf '%s' "$resp" | json_number interval)"
  expires="$(printf '%s' "$resp" | json_number expires_in)"
  [ -n "$auth_id" ] && [ -n "$authorize_url" ] || { echo "Auth start failed: $resp" >&2; exit 1; }
  activate_url="${activate_url:-$BUILDA_BASE/activate}"
  interval="${interval:-2}"
  expires="${expires:-600}"

  echo "I need your BuildaGame permission to upload a draft."
  echo "Opening the browser authorization page..."
  if ! open_authorize_url "$authorize_url"; then
    echo "Open this URL in your browser:"
    echo "$authorize_url"
  else
    echo "If the browser did not open, visit:"
    echo "$authorize_url"
  fi
  if [ -n "$user_code" ]; then
    echo
    echo "On another device, open:"
    echo "$activate_url"
    echo "Enter code: $user_code"
  fi
  echo "Log in or sign up there, click Allow agent, then return here."

  elapsed=0
  while [ "$elapsed" -lt "$expires" ]; do
    sleep "$interval"
    elapsed=$((elapsed + interval))
    poll="$(http_request "auth status" "$BUILDA_BASE/api/v1/agent/auth/status?auth_id=$auth_id")"
    status="$(printf '%s' "$poll" | json_field status)"
    case "$status" in
      approved)
        grant="$(printf '%s' "$poll" | json_field token)"
        save_grant "$grant"
        save_refresh "$(printf '%s' "$poll" | json_field refresh_token)"
        return
        ;;
      expired)
        echo "Authorization expired. Run: builda auth" >&2
        exit 1
        ;;
      pending|"")
        printf '.'
        ;;
      *)
        echo "Authorization failed: $poll" >&2
        exit 1
        ;;
    esac
  done
  echo
  echo "Authorization timed out. Run: builda auth" >&2
  exit 1
}

ensure_authorization() {
  local code="${1:-}"
  if [ -f "$TOKEN_FILE" ] && authenticated_http_request "whoami" "$BUILDA_BASE/api/v1/agent/whoami" >/dev/null 2>&1; then
    echo "authorization=ready"
    echo "grant=present"
    [ -f "$REFRESH_FILE" ] && echo "agent-authorization=present" || echo "agent-authorization=missing"
    return
  fi
  if [ ! -f "$TOKEN_FILE" ] && [ -f "$REFRESH_FILE" ] && refresh_grant; then
    echo "authorization=ready"
    echo "grant=present"
    echo "agent-authorization=present"
    return
  fi
  if [ -n "$code" ]; then
    auth_with_pair_code "$code"
  else
    auth_with_browser
  fi
  echo "authorization=ready"
  echo "grant=present"
  [ -f "$REFRESH_FILE" ] && echo "agent-authorization=present" || echo "agent-authorization=missing"
}

studio_auth() {
  ticket="${BUILDA_STUDIO_AUTH_TICKET:-}"
  [ -n "$ticket" ] || { echo "studio-auth requires BUILDA_STUDIO_AUTH_TICKET" >&2; exit 1; }
  umask 077
  mkdir -p "$AUTH_DIR"
  chmod 700 "$AUTH_DIR"
  [ -w "$AUTH_DIR" ] || { echo "studio-auth cannot write the auth directory" >&2; exit 1; }
  [ ! -f "$REFRESH_FILE" ] || {
    echo "studio-auth refuses an auth directory containing a refresh-token; use an isolated Studio HOME" >&2
    exit 1
  }
  resp="$(printf '{\"ticket\":\"%s\"}' "$ticket" | http_request "Studio auth exchange" -X POST "$BUILDA_BASE/api/v1/agent/auth/studio-exchange" -H 'Content-Type: application/json' --data-binary @-)"
  grant="$(printf '%s' "$resp" | json_field token)"
  [ -n "$grant" ] || { echo "Studio auth exchange did not return a grant." >&2; exit 1; }
  refresh="$(printf '%s' "$resp" | json_field refresh_token)"
  [ -n "$refresh" ] || { echo "Studio auth exchange did not return a renewal credential." >&2; exit 1; }
  save_grant "$grant" >/dev/null
  save_refresh "$refresh" >/dev/null
  echo "authorization=ready"
  echo "grant=present"
  echo "agent-authorization=present"
  echo "authorization-source=studio"
}

