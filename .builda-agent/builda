def cmd_md5(argv):
    print(md5_of(argv[0]))

def cmd_ledger_task(argv):
    # argv: ledgerDir taskId key=value... (merge into task record)
    path = os.path.join(argv[0], "tasks", safe_task(argv[1]) + ".json")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    record = load(path) if os.path.exists(path) else {"taskId": argv[1], "createdAt": int(time.time())}
    for kv in argv[2:]:
        k, _, v = kv.partition("=")
        if k == "files":
            merged = list(record.get("files") or [])
            merged += [f for f in v.split("\n") if f and f not in merged]
            record[k] = merged
        elif k == "status" and record.get("status") in ("done", "failed") and v not in ("done", "failed"):
            # Status only moves forward: done/failed tasks never revert to pending/running on rerun or timeout (used to tell whether this run is a reuse).
            continue
        elif v.isdigit():
            record[k] = int(v)
        else:
            record[k] = v
    record["updatedAt"] = int(time.time())
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(dump(record) + "\n")
    os.replace(tmp, path)

def cmd_ledger_out(argv):
    path = os.path.join(argv[0], "tasks", safe_task(argv[1]) + ".json")
    if os.path.exists(path):
