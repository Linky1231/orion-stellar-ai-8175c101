assets_arg = sys.argv[5] if len(sys.argv) > 5 else ""
def _csv4_ok(value: str) -> bool:
    parts = value.split(",")
    if len(parts) != 4:
        return False
    try:
        return all(float(p) >= 0 for p in parts)
    except ValueError:
        return False
if safe_area and not _csv4_ok(safe_area):
    raise SystemExit("dev --safearea must be top,right,bottom,left in CSS px, e.g. 44,0,34,0")
if port < 0 or port > 65535:
    raise SystemExit("dev port must be between 0 and 65535")

temp_dirs = []
web_root = source

def safe_extract(zip_path: pathlib.Path, prefix: str = "builda-dev-web-") -> pathlib.Path:
    td = tempfile.TemporaryDirectory(prefix=prefix)
    temp_dirs.append(td)
    dst = pathlib.Path(td.name)
    with zipfile.ZipFile(zip_path) as zf:
        for info in zf.infolist():
            name = info.filename
            pure = pathlib.PurePosixPath(name)
            if name.startswith("/") or "\\" in name or ":" in name or ".." in pure.parts:
                raise SystemExit(f"Unsafe zip path: {name}")
            if info.is_dir():
                continue
            target = dst / pathlib.Path(*pure.parts)
            target.parent.mkdir(parents=True, exist_ok=True)
            with zf.open(info) as src, target.open("wb") as out:
                shutil.copyfileobj(src, out)
    return dst

if source.is_file():
    if source.suffix.lower() != ".zip":
        raise SystemExit("dev --web file must be a .zip H5 bundle")
    web_root = safe_extract(source)
elif not source.is_dir():
    raise SystemExit("dev --web must be a directory or zip")

index = web_root / "index.html"
if not index.is_file():
    raise SystemExit(f"dev web root missing index.html: {web_root}")

# assets fallback source (audio/**, res/**, same layout as assets.zip): CPs no longer need to copy resources into the build dir;
# /audio/... /res/... requests the mock SDK resolves from the page directory are served from here when missing in the web root
assets_root = None
if assets_arg:
    assets_source = pathlib.Path(assets_arg).expanduser().resolve()
    if assets_source.is_file():
        if assets_source.suffix.lower() != ".zip":
            raise SystemExit("dev --assets file must be a .zip assets bundle")
        assets_root = safe_extract(assets_source, prefix="builda-dev-assets-")
    elif assets_source.is_dir():
        assets_root = assets_source
