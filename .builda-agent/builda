sdk_install_directory_set() {
  local transaction_root="$1"
  shift
  local backup_root="$transaction_root/backup" index=0 source destination backup failure=""
  local -a destinations=() backups=() had_old=() installed=()
  mkdir -p "$backup_root"
  if [ -f "$SDK_VERSION_FILE" ]; then cp "$SDK_VERSION_FILE" "$backup_root/sdk-version" || return 1; fi
  printf '%s\n' "$transaction_root" > "$PROJECT_STATE_DIR/.sdk-install-pending"
  while [ "$#" -gt 0 ]; do
    source="$1"
    destination="$2"
    shift 2
    [ -d "$source" ] || { failure="SDK staged directory missing: $source"; break; }
    mkdir -p "$(dirname "$destination")"
    backup="$backup_root/$index"
    if ! python3 - "$transaction_root/journal.jsonl" "$destination" "$backup" <<'PYSDK'
import json,sys
with open(sys.argv[1],'a') as f: f.write(json.dumps({'destination':sys.argv[2],'backup':sys.argv[3]})+'\n')
PYSDK
    then failure="failed to write SDK recovery journal"; break; fi
    destinations+=("$destination")
    backups+=("$backup")
    installed+=(0)
    if [ -e "$destination" ]; then
      had_old+=(1)
      if ! mv "$destination" "$backup"; then failure="failed to back up SDK directory: $destination"; break; fi
    else
      had_old+=(0)
    fi
    if ! mv "$source" "$destination"; then failure="failed to install SDK directory: $destination"; break; fi
    installed[$index]=1
    index=$((index + 1))
  done
  if [ -z "$failure" ]; then
    if printf '%s\n' "$SDK_SELECTED_VERSION" > "$transaction_root/sdk-version" && mv "$transaction_root/sdk-version" "$SDK_VERSION_FILE"; then
      return 0
    fi
    failure="failed to commit SDK version receipt"
  fi

  local rollback_failed=0 i
  for ((i=${#destinations[@]}-1; i>=0; i--)); do
    if [ "${installed[$i]}" = 1 ] && [ -e "${destinations[$i]}" ]; then
      rm -rf "${destinations[$i]}" || rollback_failed=1
    fi
    if [ "${had_old[$i]}" = 1 ] && [ -e "${backups[$i]}" ]; then
      mv "${backups[$i]}" "${destinations[$i]}" || rollback_failed=1
    fi
  done
  if [ "$rollback_failed" = 1 ]; then
    echo "BUILDA_SDK_ROLLBACK_FAILED: backup=$backup_root original=$failure" >&2
  else
    rm -f "$PROJECT_STATE_DIR/.sdk-install-pending"
    rm -rf "$transaction_root"
    echo "$failure" >&2
  fi
  return 1
}

# ---- Builda Online: multiplayer deliverables are installed under the same SDK version lock ----
# The base manifest's online block pins the immutable Online manifest of the same version; this CLI only verifies and installs the multiplayer Skill
# and its bundled deploy client .builda-online/bin, then hands installing the client SDK / Room SDK / Mock to
# `builda-online install`, which likewise reads only that version's immutable snapshot.
ONLINE_STATE_DIR=".builda-online"
ONLINE_SKILL_DIR=".agents/skills/builda-online"

sdk_online_wanted() {
  [ "${SDK_WITH_ONLINE:-0}" = 1 ] || [ -f "$ONLINE_STATE_DIR/installation.json" ] || [ -f builda.online.json ]
}

sdk_online_bootstrap() {
  local version="$1" tmp manifest_url rc output
  sdk_online_wanted || return 0
  if [ "${version%%.*}" = 0 ] && [ "$(printf '%s' "$version" | cut -d. -f2)" -lt 5 ]; then
    echo "online=unsupported (Builda SDK $version predates Builda Online delivery; run: builda sdk upgrade)"
    return 0
  fi
  need_python3
  tmp="$(mktemp -d "$PROJECT_STATE_DIR/.online-install.XXXXXX")"
  set +e
  output="$(python3 - "$BUILDA_AGENT_BASE" "$version" "$tmp" "$ONLINE_SKILL_DIR" "$ONLINE_STATE_DIR" <<'PYONLINE'
import hashlib, json, os, pathlib, re, shutil, stat, sys, urllib.request, zipfile
base, version, tmp, skill_dir, state_dir = sys.argv[1:6]
tmp = pathlib.Path(tmp)
class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k): return None
opener = urllib.request.build_opener(NoRedirect())
def fetch(url, limit=64 * 1024 * 1024):
    with opener.open(urllib.request.Request(url, headers={"User-Agent": "builda-cli"}), timeout=60) as r:
        body = r.read(limit + 1)
    if len(body) > limit: raise SystemExit("online artifact too large: " + url)
    return body
release = base + "/online/releases/" + version + "/"
try:
    manifest = json.loads(fetch(base + "/game-sdk/releases/" + version + "/manifest.json"))
except Exception as e:
    raise SystemExit("base manifest unavailable: " + str(e))
online = manifest.get("online")
if not isinstance(online, dict):
    print("online=not-included (Builda SDK " + version + " ships no Builda Online delivery)")
    raise SystemExit(3)
if online.get("manifestUrl") != release + "manifest.json":
    raise SystemExit("base manifest online.manifestUrl is not the same-version snapshot")
online_bytes = fetch(online["manifestUrl"])
if hashlib.sha256(online_bytes).hexdigest() != online.get("sha256") or len(online_bytes) != online.get("size"):
    raise SystemExit("online manifest digest does not match the base manifest")
m = json.loads(online_bytes)
if m.get("release_id") != version or m.get("public_base_url") != base + "/online":
    raise SystemExit("online manifest release_id/public_base_url mismatch")
skill = m.get("skill") or {}
url, expected = skill.get("download_url", ""), str(skill.get("sha256", "")).lower()
if not url.startswith(release) or not re.fullmatch(r"[0-9a-f]{64}", expected):
    raise SystemExit("online manifest skill entry invalid")
archive = tmp / "builda-online-skill.zip"
archive.write_bytes(fetch(url))
if hashlib.sha256(archive.read_bytes()).hexdigest() != expected:
    raise SystemExit("online skill archive SHA-256 mismatch")
stage = tmp / "stage"
with zipfile.ZipFile(archive) as z:
    names = set()
    for i in z.infolist():
        p = pathlib.PurePosixPath(i.filename)
        if p.is_absolute() or ".." in p.parts or "\\" in i.filename or ":" in i.filename or i.filename in names:
            raise SystemExit("unsafe online skill archive")
        if stat.S_ISLNK(i.external_attr >> 16): raise SystemExit("unsafe online skill archive")
        names.add(i.filename)
    if sum(i.file_size for i in z.infolist()) > 64 * 1024 * 1024: raise SystemExit("online skill archive too large")
    roots = {n.split("/", 1)[0] for n in names}
    if roots != {"builda-online"}: raise SystemExit("online skill archive must contain a single builda-online/ root")
    for required in ("VERSION", "SKILL.md", "bin/builda-online.py", "bin/builda_online/install.py", "references/resource-limits.md"):
        if "builda-online/" + required not in names: raise SystemExit("online skill archive is missing " + required)
    if z.read("builda-online/VERSION").decode().strip() != str(skill.get("version")):
        raise SystemExit("online skill VERSION does not match the manifest")
    for i in z.infolist():
        target = stage / i.filename
        if i.is_dir(): target.mkdir(parents=True, exist_ok=True); continue
        target.parent.mkdir(parents=True, exist_ok=True)
        with z.open(i) as src, open(target, "wb") as dst: shutil.copyfileobj(src, dst)
        if (i.external_attr >> 16) & 0o111: target.chmod(0o755)
def replace(source, relative):
    target = pathlib.Path(relative).resolve()
    if pathlib.Path.cwd().resolve() not in target.parents: raise SystemExit("refusing to write outside the project")
    target.parent.mkdir(parents=True, exist_ok=True)
    staged = target.parent / ("." + target.name + ".builda-new")
    if staged.exists(): shutil.rmtree(staged)
    shutil.copytree(source, staged, symlinks=False)
    if target.is_symlink(): target.unlink()
    elif target.exists(): shutil.rmtree(target)
    os.replace(staged, target)
replace(stage / "builda-online", skill_dir)
replace(stage / "builda-online" / "bin", pathlib.Path(state_dir) / "bin")
(tmp / "manifest-url").write_text(online["manifestUrl"])
print("online-release=" + version)
print("online-skill-version=" + str(skill.get("version")))
print("online-skill=" + skill_dir + "/SKILL.md")
print("online-deploy-client=" + state_dir + "/bin/builda-online")
PYONLINE
)"
  rc=$?
  set -e
  [ -n "$output" ] && printf '%s\n' "$output"
  if [ "$rc" = 3 ]; then rm -rf "$tmp"; return 0; fi
  if [ "$rc" != 0 ]; then
    rm -rf "$tmp"
    echo "online-install=failed (Builda Online skill could not be installed for SDK $version; base SDK is installed)" >&2
    return 1
  fi
  manifest_url="$(cat "$tmp/manifest-url")"
  rm -rf "$tmp"
  local -a installer_args=(install --project-root . --manifest-url "$manifest_url")
  [ -n "${SDK_ONLINE_ROOM_LANGUAGE:-}" ] && installer_args+=(--room-language "$SDK_ONLINE_ROOM_LANGUAGE")
  set +e
  output="$(python3 "$ONLINE_STATE_DIR/bin/builda-online.py" "${installer_args[@]}" 2>&1)"
  rc=$?
  set -e
  [ -n "$output" ] && printf '%s\n' "$output"
  if [ "$rc" = 0 ]; then
    echo "online-install=ok"
    return 0
  fi
  case "$output" in
    *"Cannot determine the Room language"*)
      echo "online-install=needs-room-language (ask the user which Room language to use, then run: ./$ONLINE_STATE_DIR/bin/builda-online install --room-language typescript|rust)" >&2 ;;
    *"Cannot determine the client engine"*)
      echo "online-install=needs-client-sdk (run: ./$ONLINE_STATE_DIR/bin/builda-online install --client-sdk godot|h5|cocos|unity)" >&2 ;;
    *) echo "online-install=failed (fix the error above, then run: ./$ONLINE_STATE_DIR/bin/builda-online install)" >&2 ;;
  esac
  return 1
}

# Report how multiplayer deliverables relate to the SDK version lock; installs nothing, no network.
sdk_online_status() {
  local record="$ONLINE_STATE_DIR/installation.json" pin="" release
  [ -f "$record" ] || return 0
  [ -f "$SDK_VERSION_FILE" ] && pin="$(head -n 1 "$SDK_VERSION_FILE" | tr -d '\r')"
  release="$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("releaseId") or "")
except Exception: print("")' "$record" 2>/dev/null || true)"
  if [ -z "$release" ]; then
    echo "online-release=unrecorded"
    echo "online-status=unrecorded (run: ./$ONLINE_STATE_DIR/bin/builda-online install --manifest-url $BUILDA_AGENT_BASE/online/releases/${pin:-<sdk-version>}/manifest.json)"
  elif [ -n "$pin" ] && [ "$release" = "$pin" ]; then
