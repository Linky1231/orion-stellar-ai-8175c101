  fi
  sdk_ensure_autoload
}

sdk_ensure_autoload() {
  [ -f project.godot ] || return 0
  local tmp
  tmp="$(mktemp)"
  awk '
    BEGIN { in_autoload=0; wrote=0; saw_autoload=0 }
    /^\[autoload\]$/ {
      in_autoload=1
      saw_autoload=1
      print
      next
    }
    /^\[/ {
      if (in_autoload && !wrote) {
        print "BuildaClient=\"*res://scripts/BuildaClient.gd\""
        wrote=1
      }
      in_autoload=0
    }
    in_autoload && /^BuildaClient=/ {
      if (!wrote) {
        print "BuildaClient=\"*res://scripts/BuildaClient.gd\""
        wrote=1
      }
      next
    }
    { print }
    END {
      if (!wrote) {
        if (!saw_autoload) {
          print ""
          print "[autoload]"
        }
        print "BuildaClient=\"*res://scripts/BuildaClient.gd\""
      }
    }
  ' project.godot > "$tmp"
  mv "$tmp" project.godot
  echo "sdk-autoload=BuildaClient"
}

sdk_ensure_web_head_include() {
  [ -f export_presets.cfg ] || { echo "sdk-web-head=export_presets.cfg missing"; return 0; }
  command -v python3 >/dev/null 2>&1 || { echo "sdk-web-head=python3 missing"; return 0; }
  python3 - <<'PY'
from pathlib import Path
import re

path = Path("export_presets.cfg")
text = path.read_text(encoding="utf-8", errors="ignore")
script = '<script src="builda-sdk.js"></script>'
lines = text.splitlines()

web_ids = set()
current = None
for line in lines:
    match = re.match(r"\[preset\.(\d+)\]$", line)
    if match:
        current = match.group(1)
        continue
    if line.startswith("["):
        current = None
        continue
    if current is not None and line == 'platform="Web"':
        web_ids.add(current)

if not web_ids:
    print("sdk-web-head=no web preset")
    raise SystemExit(0)

out = []
current_section = None
in_web_options = False
seen_head = False
changed = False
already_ok = False

def inject_head(line: str) -> str:
    prefix = "html/head_include="
    value = line[len(prefix):]
    if "builda-sdk.js" in value:
        migrated = value.replace('addons/builda/web/builda-sdk.js', 'builda-sdk.js')
        if migrated != value:
            return prefix + migrated
        return line
    if value == '""':
        return prefix + '"<script src=\\"builda-sdk.js\\"></script>"'
    if value.startswith('"') and value.endswith('"'):
        return prefix + value[:-1] + '\\n<script src=\\"builda-sdk.js\\"></script>"'
    return line

for line in lines:
    section = re.match(r"\[preset\.(\d+)(\.options)?\]$", line)
    if section:
        if in_web_options and not seen_head:
            out.append('html/head_include="<script src=\\"builda-sdk.js\\"></script>"')
            changed = True
        current_section = section.group(1)
        in_web_options = section.group(1) in web_ids and bool(section.group(2))
        seen_head = False
        out.append(line)
        continue
    if line.startswith("["):
        if in_web_options and not seen_head:
            out.append('html/head_include="<script src=\\"builda-sdk.js\\"></script>"')
            changed = True
        current_section = None
        in_web_options = False
        seen_head = False
        out.append(line)
        continue
    if current_section in web_ids and not in_web_options and line.startswith("html/head_include="):
        seen_head = True
        new_line = inject_head(line)
        already_ok = already_ok or "builda-sdk.js" in new_line
        changed = changed or new_line != line
        out.append(new_line)
        continue
    if in_web_options and line.startswith("html/head_include="):
        seen_head = True
        new_line = inject_head(line)
        already_ok = already_ok or "builda-sdk.js" in new_line
        changed = changed or new_line != line
        out.append(new_line)
        continue
    out.append(line)

if in_web_options and not seen_head:
    out.append('html/head_include="<script src=\\"builda-sdk.js\\"></script>"')
    changed = True

if changed:
    path.write_text("\n".join(out) + "\n", encoding="utf-8")
    print("sdk-web-head=builda-sdk.js injected")
elif already_ok:
    print("sdk-web-head=builda-sdk.js exists")
else:
    print("sdk-web-head=builda-sdk.js missing")
    raise SystemExit(1)
PY
}

