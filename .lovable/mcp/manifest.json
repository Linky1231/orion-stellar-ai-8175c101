{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://aearqupvveahlhcbzgpv.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "orion-estellar-ai",
      "version": "0.1.0",
      "title": "Orión Estellar AI"
    },
    "tools": [
      {
        "name": "list_conversations",
        "title": "Listar chats",
        "description": "Lista los chats recientes del usuario con Orión.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Máximo de chats (por defecto 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_messages",
        "title": "Leer chat",
        "description": "Devuelve los mensajes de un chat del usuario.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "conversation_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID del chat."
            }
          },
          "required": [
            "conversation_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_notes",
        "title": "Listar notas",
        "description": "Lista las notas del usuario en el Modo Notas.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Máximo de notas (por defecto 30).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_memory",
        "title": "Ver memoria",
        "description": "Devuelve lo que Orión recuerda del usuario.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Máximo de entradas (por defecto 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "add_memory",
        "title": "Guardar recuerdo",
        "description": "Guarda un dato nuevo en la memoria de Orión sobre el usuario.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "Lo que Orión debe recordar."
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
